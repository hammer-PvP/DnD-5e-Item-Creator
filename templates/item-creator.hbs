        <section class="ic-enhancement-card {{#if enhancement.removeStrengthRequirement}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="removeStrengthRequirement" {{#if enhancement.removeStrengthRequirement}}checked{{/if}}><span><strong>Remove Strength Requirement</strong><small>Set the native Strength requirement to none.</small></span></label></section>
