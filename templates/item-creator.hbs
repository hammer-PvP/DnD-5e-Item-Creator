                  <aside class="ic-triggered-note ic-triggered-wide"><i class="fa-solid fa-circle-info"></i><span><strong>Critical Hit</strong> follows the attack's configured critical threshold. <strong>Natural 20</strong> requires an active d20 result of exactly 20.</span></aside>
                  {{/if}}

                  {{#if showSpellFilters}}
                  <label><span>Spell Level</span><select data-trigger-input="spellLevel" data-trigger-scope="trigger" data-trigger-id="{{id}}">{{#each spellLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Spell School</span><select data-trigger-input="spellSchool" data-trigger-scope="trigger" data-trigger-id="{{id}}">{{#each spellSchoolOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <aside class="ic-triggered-note ic-triggered-wide"><i class="fa-solid fa-circle-info"></i><span>{{spellFilterExplanation}}</span></aside>
                  {{/if}}

                  {{#if showSpecificSpell}}
                  <div class="ic-trigger-source-picker ic-triggered-wide"><span><strong>Selected Spell</strong><small>{{#if trigger.spellName}}{{trigger.spellName}}{{else}}No Spell selected{{/if}}</small></span><button type="button" data-action="browse-trigger-spell" data-trigger-id="{{id}}"><i class="fa-solid fa-books"></i> Browse Spell</button></div>
                  {{/if}}

                  {{#if showResourceFilter}}
                  <label class="ic-triggered-wide"><span>Resource</span><select data-trigger-input="resourceId" data-trigger-scope="trigger" data-trigger-id="{{id}}">{{#each resourceGroups}}<optgroup label="{{label}}">{{#each items}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}</select></label>
                  {{/if}}

                  {{#if showSlotLevel}}
                  <label><span>Slot Level</span><select data-trigger-input="spellSlotLevel" data-trigger-scope="trigger" data-trigger-id="{{id}}">{{#each spellSlotLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{/if}}

                  {{#if showSpecificFeature}}
                  <div class="ic-trigger-source-picker ic-triggered-wide"><span><strong>Selected Feature</strong><small>{{#if trigger.featureName}}{{trigger.featureName}}{{else}}No Feature selected{{/if}}</small></span><button type="button" data-action="browse-trigger-feature" data-trigger-id="{{id}}"><i class="fa-solid fa-books"></i> Browse Feature</button></div>
                  {{/if}}

                  {{#if showDamageFilters}}
                  <label><span>Source</span><select data-trigger-input="damageSource" data-trigger-scope="trigger" data-trigger-id="{{id}}">{{#each damageSourceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Damage Type</span><select data-trigger-input="damageType" data-trigger-scope="trigger" data-trigger-id="{{id}}">{{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Minimum Amount</span><input type="number" min="0" step="1" value="{{trigger.minimumAmount}}" data-trigger-input="minimumAmount" data-trigger-scope="trigger" data-trigger-id="{{id}}" data-value-type="number"></label>
                  {{/if}}
                </div>
              </section>

              <section class="ic-triggered-subsection">
                <header><i class="fa-solid fa-list-ol"></i><strong>Activation Counting</strong></header>
                <div class="ic-triggered-grid three-columns">
                  <label><span>Count As</span><select data-trigger-input="counting" data-trigger-id="{{id}}">{{#each countingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Maximum per Turn</span><input type="number" min="0" max="99" step="1" value="{{maxPerTurn}}" data-trigger-input="maxPerTurn" data-trigger-id="{{id}}" data-value-type="number"><small>0 = unlimited</small></label>
                  <label><span>Maximum per Round</span><input type="number" min="0" max="99" step="1" value="{{maxPerRound}}" data-trigger-input="maxPerRound" data-trigger-id="{{id}}" data-value-type="number"><small>0 = unlimited</small></label>
                </div>
              </section>

              <section class="ic-triggered-subsection">
                <header><i class="fa-solid fa-layer-group"></i><strong>Application &amp; Duration</strong></header>
                <div class="ic-triggered-grid four-columns">
                  <label class="ic-triggered-span-two"><span>Application Mode</span><select data-trigger-input="mode" data-trigger-scope="application" data-trigger-id="{{id}}">{{#each applicationModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>

                  {{#if isSingleActivation}}
                  <label><span>Expires At</span><select data-trigger-input="expiration" data-trigger-scope="application" data-trigger-id="{{id}}">{{#each singleActivationExpirationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>When Triggered Again</span><select data-trigger-input="retrigger" data-trigger-scope="application" data-trigger-id="{{id}}">{{#each retriggerBehaviorOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{else}}
                  {{#if showStackQuantityFields}}
                  <label><span>Stacks per Activation</span><input type="number" min="1" max="99" step="1" value="{{stacks.granted}}" data-trigger-input="granted" data-trigger-scope="stacks" data-trigger-id="{{id}}" data-value-type="number"></label>
                  <label><span>Maximum Stacks</span><input type="number" min="1" max="999" step="1" value="{{stacks.maximum}}" data-trigger-input="maximum" data-trigger-scope="stacks" data-trigger-id="{{id}}" data-value-type="number"></label>
                  {{/if}}
                  <label class="ic-triggered-span-two"><span>Stack Behavior</span><select data-trigger-input="behavior" data-trigger-scope="stacks" data-trigger-id="{{id}}">{{#each stackBehaviorOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>

                  {{#if showDurationFields}}
                  <label><span>Duration</span><input type="number" min="1" max="999" step="1" value="{{stacks.durationAmount}}" data-trigger-input="durationAmount" data-trigger-scope="stacks" data-trigger-id="{{id}}" data-value-type="number"></label>
                  {{/if}}

                  {{#if showInactivityGrace}}
                  <label><span>Inactivity Grace</span><input type="number" min="0" max="999" step="1" value="{{stacks.inactivityGrace}}" data-trigger-input="inactivityGrace" data-trigger-scope="stacks" data-trigger-id="{{id}}" data-value-type="number"></label>
                  {{/if}}
                  {{#if showDecayFields}}
                  <label><span>Stacks Lost per Tick</span><input type="number" min="1" max="999" step="1" value="{{stacks.decayAmount}}" data-trigger-input="decayAmount" data-trigger-scope="stacks" data-trigger-id="{{id}}" data-value-type="number"></label>
                  {{/if}}
                  {{#if showTrackingFields}}
                  <label><span>Duration Follows</span><select data-trigger-input="durationUnit" data-trigger-scope="stacks" data-trigger-id="{{id}}">{{#each durationUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Tick / Expire At</span><select data-trigger-input="tickTiming" data-trigger-scope="stacks" data-trigger-id="{{id}}">{{#each tickTimingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{/if}}
                  {{/if}}
                </div>
                {{#if isSingleActivation}}
                <aside class="ic-triggered-note"><i class="fa-solid fa-stopwatch"></i><span>{{durationGuidance}} Choose whether a new trigger refreshes its lifetime or is ignored while that recipient already has the effect. If the selected Actor is not currently taking a turn, the next matching turn boundary is used.</span></aside>
                {{else if isSingleAttack}}
                <aside class="ic-triggered-note"><i class="fa-solid fa-bullseye"></i><span>The effect is applied after the successful attack roll and removed after the next damage roll from that same Activity. If no damage is rolled, it is removed at the end of the owner's current turn. Damage bonuses can affect that roll; attack bonuses cannot retroactively alter an attack already rolled.</span></aside>
                {{else}}
                <aside class="ic-triggered-note"><i class="fa-solid fa-stopwatch"></i><span>{{durationGuidance}} Ending or deleting the Combat removes all stacks and effects.</span></aside>
                {{#if targetClockWarning}}
                <aside class="ic-triggered-note ic-triggered-warning"><i class="fa-solid fa-triangle-exclamation"></i><span>This Trigger applies one or more effects to target Actors, but the duration currently follows the <strong>source Actor</strong>. {{#if isSingleActivation}}Choose a recipient-based option under <strong>Expires At</strong> to count each target's own turn.{{else}}Choose <strong>Effect Recipient Turns</strong> under <strong>Duration Follows</strong> to count each target's own turns.{{/if}}</span></aside>
                {{/if}}
                {{/if}}

                <div class="ic-triggered-consumption-block {{#if isSaveGated}}enabled{{/if}}">
                  <div class="ic-triggered-grid four-columns">
                    <label class="ic-triggered-span-two"><span>Effect Application</span><select data-trigger-input="mode" data-trigger-scope="effectApplication" data-trigger-id="{{id}}">{{#each effectApplicationModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if isSaveGated}}
                    <label><span>Saving Throw</span><select data-trigger-input="saveAbility" data-trigger-scope="effectApplication" data-trigger-id="{{id}}">{{#each saveAbilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label><span>Save DC</span><select data-trigger-input="saveDcMode" data-trigger-scope="effectApplication" data-trigger-id="{{id}}">{{#each saveDcModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if (eq effectApplication.saveDcMode "formula")}}
                    <label class="ic-triggered-span-two"><span>DC Formula</span><input type="text" value="{{effectApplication.saveDcFormula}}" placeholder="8 + @prof + @abilities.cha.mod" data-trigger-input="saveDcFormula" data-trigger-scope="effectApplication" data-trigger-id="{{id}}"></label>
                    {{else}}
                    <label><span>Fixed DC</span><input type="number" min="1" max="99" step="1" value="{{effectApplication.saveDc}}" data-trigger-input="saveDc" data-trigger-scope="effectApplication" data-trigger-id="{{id}}" data-value-type="number"></label>
                    {{/if}}
                    {{/if}}
                  </div>
                  {{#if isSaveGated}}
                  <aside class="ic-triggered-note"><i class="fa-solid fa-shield-heart"></i><span><strong>Saving Throw → GM Applies Effect</strong> creates a native D&amp;D5e save/chat workflow. The Item Creator does not decide who failed and does not auto-apply from hidden results. The GM uses the native Effects tray to apply the configured target effects. Their duration remains controlled by this Triggered Effect; concentration is not inferred from a copied Spell.</span></aside>
                  {{else}}
                  <aside class="ic-triggered-note"><i class="fa-solid fa-bolt"></i><span><strong>Immediate</strong> keeps the current behavior: the configured effect is applied as soon as this trigger resolves.</span></aside>
                  {{/if}}
                </div>

                <div class="ic-triggered-consumption-block {{#if consumptionEnabled}}enabled{{/if}}">
                  <label class="ic-checkbox-line ic-triggered-consumption-toggle">
                    <input type="checkbox" data-trigger-input="enabled" data-trigger-scope="consumption" data-trigger-id="{{id}}" {{#if consumptionEnabled}}checked{{/if}} {{#if consumptionBlocked}}disabled{{else if hasRollDiceModifier}}disabled{{/if}}>
                    <span><strong>Remove When Consumed</strong><small>{{#if isSaveGated}}Not used by the native Save-Gated workflow in this version.{{else if hasContextualModifier}}Contextual Roll Modifiers use the Triggered Effect's normal duration/stacks in this version.{{else if hasRollDiceModifier}}Required by Add/Subtract Dice; change or remove that Applied Effect to disable consumption.{{else}}Add an early-removal condition without replacing the duration above.{{/if}}</small></span>
                  </label>
                  {{#if consumptionEnabled}}
                  <div class="ic-triggered-grid four-columns">
                    <label><span>Uses Before Removal</span><input type="number" min="1" max="999" step="1" value="{{consumption.uses}}" data-trigger-input="uses" data-trigger-scope="consumption" data-trigger-id="{{id}}" data-value-type="number"></label>
                    <label><span>Eligible Roll</span><select data-trigger-input="event" data-trigger-scope="consumption" data-trigger-id="{{id}}">{{#each consumptionEventOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label><span>Ask / Use Timing</span><select data-trigger-input="timing" data-trigger-scope="consumption" data-trigger-id="{{id}}">{{#each consumptionTimingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label><span>Use Decision</span><select data-trigger-input="decision" data-trigger-scope="consumption" data-trigger-id="{{id}}">{{#each consumptionDecisionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  </div>
                  <aside class="ic-triggered-note"><i class="fa-solid fa-hourglass-half"></i><span>The recipient immediately gains a visible active effect. It remains until its normal duration ends or its configured uses reach zero, whichever happens first. Declining preserves every use.</span></aside>
                  {{#if hasRollDiceModifier}}
                  <aside class="ic-triggered-note"><i class="fa-solid fa-dice"></i><span><strong>Add/Subtract Dice</strong> uses the Eligible Roll, timing, decision, and use count above. It does not create a second Damage Roll layer. Choose Attack Roll, Ability Check, Saving Throw, or Any D20 Test; the configured dice are applied only to the confirmed eligible roll.</span></aside>
                  {{/if}}
                  {{#if consumptionAfterRoll}}
                  <aside class="ic-triggered-note"><i class="fa-solid fa-shield-halved"></i><span><strong>After the Roll</strong> offers <strong>Use / Keep</strong> after every eligible roll while the effect is available. The offer never depends on hidden AC/DC or success/failure. The player sees only the current roll total and the available bonus; adjudication remains with the native D&D5e workflow and the GM.</span></aside>
                  {{else}}
                  <aside class="ic-triggered-note"><i class="fa-solid fa-dice-d20"></i><span><strong>Before the Roll</strong> enables the managed payload only for the confirmed native roll. Cancelling the roll preserves every use.</span></aside>
                  {{/if}}
                  {{/if}}
                </div>
              </section>

              <section class="ic-triggered-subsection">
                <header><i class="fa-solid fa-wand-magic-sparkles"></i><strong>Applied Effects</strong></header>
                <div class="ic-triggered-payload-list">
                  {{#each effects}}
                  <article class="ic-triggered-payload" data-payload-id="{{id}}">
                    <header><strong>Effect {{index}}</strong><button type="button" class="ic-row-remove" data-action="remove-triggered-payload" data-trigger-id="{{../id}}" data-payload-id="{{id}}" aria-label="Remove effect"><i class="fa-solid fa-trash"></i></button></header>
                    <div class="ic-triggered-grid four-columns">
                      <label class="ic-triggered-span-two"><span>Effect</span><select data-trigger-payload-input="type" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <label><span>Effect Recipient</span><select data-trigger-payload-input="recipient" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each recipientOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{#if showScaling}}<label><span>Scaling</span><select data-trigger-payload-input="scaling" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each scalingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}

                      {{#if isSelectedSpellEffects}}
                      <div class="ic-trigger-source-picker ic-triggered-wide"><span><strong>Selected Spell</strong><small>{{#if spellName}}{{spellName}} — {{selectedSpellEffectCount}} transferable Active Effect(s){{else}}No Spell selected{{/if}}</small></span><button type="button" data-action="browse-trigger-effect-spell" data-trigger-id="{{../id}}" data-payload-id="{{id}}"><i class="fa-solid fa-books"></i> Browse Spell</button></div>
                      <aside class="ic-triggered-note ic-triggered-wide"><i class="fa-solid fa-circle-info"></i><span>Only the selected Spell's Active Effects and conditions are copied. The Spell is not cast: no slot, action, target workflow, saving throw, original duration, or concentration is used. Application and expiration come from this Triggered Effect. For target effects, choose <strong>Effect Recipient Turns</strong> in Application &amp; Duration to count the affected Actor's own turns.</span></aside>
                      {{else if isContextualModifier}}
                      <label><span>Roll Type</span><select data-trigger-payload-input="contextualRollType" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each contextualRollTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <label><span>Relationship</span><select data-trigger-payload-input="contextualRelationship" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each contextualRelationshipOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <label><span>Operation</span><select data-trigger-payload-input="contextualOperation" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each contextualOperationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{#if contextualDiceOperation}}
                      <label><span>Dice</span><input type="number" min="1" max="99" step="1" value="{{diceNumber}}" data-trigger-payload-input="diceNumber" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number"></label>
                      <label><span>Die</span><select data-trigger-payload-input="die" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{else if contextualFlatOperation}}
                      <label><span>Amount</span><input type="number" min="0" step="1" value="{{amount}}" data-trigger-payload-input="amount" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number"></label>
                      {{/if}}
                      <aside class="ic-triggered-note ic-triggered-wide"><i class="fa-solid fa-arrows-left-right-to-line"></i><span>This Active Effect stores a contextual declaration instead of permanently changing the roller. <strong>Roll Made by Effect Recipient</strong> modifies that Actor's eligible rolls. <strong>Attack Made Against Effect Recipient</strong> modifies an attack only when this Actor is the attacker's single current target.</span></aside>
                      {{else if isRollDiceModifier}}
                      <label><span>Dice</span><input type="number" min="1" max="99" step="1" value="{{diceNumber}}" data-trigger-payload-input="diceNumber" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number"></label>
                      <label><span>Die</span><select data-trigger-payload-input="die" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <aside class="ic-triggered-note ic-triggered-wide"><i class="fa-solid fa-dice-d20"></i><span>{{#if isSubtractRollDice}}Subtracts{{else}}Adds{{/if}} this dice formula from or to the roll selected under <strong>Remove When Consumed → Eligible Roll</strong>. The effect can target the Item owner or the Trigger Target(s), and each confirmed use consumes one configured use.</span></aside>
                      {{else if isNumeric}}
                      <label><span>Calculation</span><select data-trigger-payload-input="calculation" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each calculationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{#if isDice}}
                      <label><span>Dice</span><input type="number" min="1" max="99" step="1" value="{{diceNumber}}" data-trigger-payload-input="diceNumber" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number"></label>
                      <label><span>Die</span><select data-trigger-payload-input="die" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{else if isCustomFormula}}
                      <label class="ic-triggered-span-two"><span>Formula</span><input type="text" value="{{formula}}" placeholder="@prof + 1d4" data-trigger-payload-input="formula" data-trigger-id="{{../id}}" data-payload-id="{{id}}"><small>Uses D&D5e roll data. Per Stack multiplies the complete formula.</small></label>
                      {{else if (eq calculation "flat")}}
                      <label><span>Amount</span><input type="number" step="1" value="{{amount}}" data-trigger-payload-input="amount" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number"></label>
                      {{/if}}
                      {{/if}}

                      {{#if isSavingThrow}}<label><span>Saving Throw</span><select data-trigger-payload-input="ability" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each abilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
                      {{#if isMovement}}<label><span>Movement Type</span><select data-trigger-payload-input="movementType" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each movementTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
                      {{#if isDamageTrait}}<label><span>Damage Type</span><select data-trigger-payload-input="damageType" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
                      {{#if isConditionTrait}}<label><span>Condition</span><select data-trigger-payload-input="condition" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each conditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
                      {{#if isCriticalThreshold}}
                      <label><span>Applies To</span><select data-trigger-payload-input="criticalScope" data-trigger-id="{{../id}}" data-payload-id="{{id}}">{{#each criticalScopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <label><span>Critical Hit On</span><select data-trigger-payload-input="criticalThreshold" data-trigger-id="{{../id}}" data-payload-id="{{id}}" data-value-type="number">{{#each criticalThresholdOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{/if}}
                    </div>
                  </article>
                  {{/each}}
                </div>
                <aside class="ic-triggered-note"><i class="fa-solid fa-crosshairs"></i><span><strong>Trigger Target(s)</strong> uses the Actor targets recorded by the D&amp;D5e Activity or attack. Damage and healing events use the Actor that actually received the change. When no valid target exists, target effects are skipped; they never fall back to the Item owner. Formulas on normal effects use the recipient Actor's roll data. Recipient-turn expiration requires that recipient to have a Combat turn; otherwise Combat cleanup remains the final boundary.</span></aside>
                <button type="button" class="ic-add-triggered-payload" data-action="add-triggered-payload" data-trigger-id="{{id}}"><i class="fa-solid fa-plus"></i> Add Applied Effect</button>
              </section>
            </div>
          </article>
          {{/each}}
        </div>
        {{else}}
        <div class="ic-triggered-empty-state"><i class="fa-solid fa-bolt"></i><strong>No Triggered Effects</strong><p>Add an event-driven temporary effect. The GM controls balance; the runtime controls tracking and cleanup.</p></div>
        {{/if}}

        <button type="button" class="ic-add-triggered-effect" data-action="add-triggered-effect"><i class="fa-solid fa-plus"></i> Add Triggered Effect</button>
      </section>

      {{#if customImportedEffectRows.length}}
      <section class="ic-effect-group ic-imported-custom-group">
        <header><span class="ic-kicker">Imported Custom Effects</span><h3>Untranslated or Independent Active Effect Data</h3><p>These changes are not folded into a normal Creator field, either because their key is unknown or because they must remain independent. They are rebuilt as new normalized Effects and can be kept, disabled, or removed.</p></header>
        <div class="ic-imported-custom-list">
          {{#each customImportedEffectRows}}
          <article class="ic-imported-custom-card {{#unless included}}excluded{{/unless}}">
            <header><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{summary}}</small></span><button type="button" data-action="remove-imported-effect" data-imported-id="{{id}}" aria-label="Remove imported effect"><i class="fa-solid fa-trash"></i></button></header>
            <div class="ic-imported-custom-controls">
              <label><input type="checkbox" data-imported-effect-input="included" data-imported-id="{{id}}" {{#if included}}checked{{/if}}><span>Include in final Item</span></label>
              <label><input type="checkbox" data-imported-effect-input="disabled" data-imported-id="{{id}}" {{#if disabled}}checked{{/if}}><span>Create Disabled</span></label>
            </div>
            <details><summary>Technical data</summary><pre>{{technical}}</pre></details>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if customImportedActivityRows.length}}
      <section class="ic-effect-group ic-imported-custom-group">
        <header><span class="ic-kicker">Imported Custom Activities</span><h3>Unrecognized Activity Data</h3><p>These Activities are rebuilt from the imported source. Disable an entry to keep its configuration in the Creator draft without placing it on the final Item.</p></header>
        <div class="ic-imported-custom-list">
          {{#each customImportedActivityRows}}
          <article class="ic-imported-custom-card {{#unless included}}excluded{{/unless}}">
            <header><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{summary}}</small></span><button type="button" data-action="remove-imported-activity" data-imported-id="{{id}}" aria-label="Remove imported activity"><i class="fa-solid fa-trash"></i></button></header>
            <div class="ic-imported-custom-controls">
              <label><input type="checkbox" data-imported-activity-input="included" data-imported-id="{{id}}" {{#if included}}checked{{/if}}><span>Include in final Item</span></label>
              <label><input type="checkbox" data-imported-activity-input="disabled" data-imported-id="{{id}}" {{#if disabled}}checked{{/if}}><span>Disable Activity</span></label>
            </div>
            <details><summary>Technical data</summary><pre>{{technical}}</pre></details>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless grantedEffectsComplete}}disabled{{/unless}}><span>Spells &amp; Resources</span><i class="fa-solid fa-chevron-right"></i></button>
    </footer>
    {{/if}}

    {{#if (eq step "spellsResources")}}
    <section class="ic-step-content ic-spells-resources-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Item Powers</span>
          <h2>Spells &amp; Resources</h2>
          <p>Grant native Spells and modify class, subclass, spell-slot, Pact Magic, and resource-die pools. Balance is controlled by the GM; Item Creator focuses on applying and removing the configured power safely.</p>
        </div>
      </header>

      <section class="ic-enhancement-group ic-spellcasting-group">
        <header>
          <span class="ic-kicker">Granted Magic</span>
          <h3>Granted Spellcasting</h3>
        </header>
        <section class="ic-enhancement-card ic-span-two ic-granted-spellcasting-card {{#if enhancement.grantedSpellcasting}}enabled{{/if}} {{#if spellsResourcesErrors.grantedSpellcasting}}invalid{{/if}}">
          <label class="ic-override-heading">
            <input type="checkbox" data-enhancement-toggle="grantedSpellcasting" {{#if enhancement.grantedSpellcasting}}checked{{/if}}>
            <span><strong>Granted Spellcasting</strong><small>Grant one or more existing Spells through this item. Each Spell has independent uses, recovery, slot consumption, eligibility, cast level, spellcasting calculation, spellbook visibility, and availability.</small></span>
          </label>

          <div class="ic-spell-drop-zone {{#unless enhancement.grantedSpellcasting}}disabled{{/unless}}" data-spell-drop-zone>
            <i class="fa-solid fa-wand-sparkles"></i>
            <div>
              <strong>Drop a Spell here</strong>
              <small>Drag a Spell Item from a compendium or directory, or use the native D&amp;D5e Spell Browser.</small>
            </div>
            <button type="button" data-action="browse-spells" {{#unless enhancement.grantedSpellcasting}}disabled{{/unless}}>
              <i class="fa-solid fa-books"></i> Browse Spells
            </button>
          </div>

          {{#if enhancement.grantedSpellcasting}}
            {{#if grantedSpellRows.length}}
            <div class="ic-granted-spell-list">
              {{#each grantedSpellRows}}
              <article class="ic-granted-spell {{#if invalid}}invalid{{/if}}" data-spell-id="{{id}}">
                <header class="ic-granted-spell-header">
                  <img src="{{img}}" alt="{{name}}">
                  <div>
                    <strong>{{name}}</strong>
                    <span>{{spellLevelLabel}} · {{schoolLabel}}</span>
                    <small>{{source}}</small>
                  </div>
                  <button type="button" class="ic-icon-button danger" data-action="remove-granted-spell" data-spell-id="{{id}}" aria-label="Remove {{name}}" title="Remove Spell">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </header>

                <div class="ic-spell-config-grid">
                  <section class="ic-spell-config-panel">
                    <h4>Uses and Recovery</h4>
                    <label><span>Use Limit</span><select data-granted-spell-input="useLimit" data-spell-id="{{id}}">{{#each useLimitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if isLimited}}
                    <div class="ic-spell-inline-fields">
                      <label><span>Maximum Uses</span><input type="number" min="1" max="99" step="1" value="{{maxUses}}" data-granted-spell-input="maxUses" data-spell-id="{{id}}" data-value-type="number"></label>
                      <label><span>Recovery</span><select data-granted-spell-input="recovery" data-spell-id="{{id}}">{{#each recoveryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    </div>
                    {{else}}
                    <small class="ic-field-note">Unlimited means the item has no charge limit. Spell-slot consumption can still limit actual use.</small>
                    {{/if}}
                    <label class="ic-checkbox-line {{#if isCantrip}}disabled{{/if}}">
                      <input type="checkbox" data-granted-spell-input="consumeSlot" data-spell-id="{{id}}" {{#if consumeSlot}}checked{{/if}} {{#if isCantrip}}disabled{{/if}}>
                      <span><strong>Consume a Spell Slot</strong><small>{{#if isCantrip}}Cantrips never consume spell slots.{{else}}Require and consume a compatible slot for every cast.{{/if}}</small></span>
                    </label>
                  </section>

                  <section class="ic-spell-config-panel">
                    <h4>Eligibility and Cast Level</h4>
                    <label><span>Casting Eligibility</span><select data-granted-spell-input="eligibility" data-spell-id="{{id}}" {{#if consumeSlot}}disabled{{/if}}>{{#each eligibilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if consumeSlot}}<small class="ic-field-note">Spell-slot consumption automatically requires a compatible spell slot.</small>{{/if}}
                    <label><span>Cast Level</span><select data-granted-spell-input="castLevelMode" data-spell-id="{{id}}">{{#each castLevelModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if (eq castLevelMode "fixed")}}
                    <label><span>Fixed Cast Level</span><select data-granted-spell-input="fixedCastLevel" data-spell-id="{{id}}" data-value-type="number">{{#each fixedCastLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{/if}}
                  </section>

                  <section class="ic-spell-config-panel ic-spellcasting-calculation">
                    <h4>Spellcasting Calculation</h4>
                    <label><span>Spellcasting</span><select data-granted-spell-input="spellcastingMode" data-spell-id="{{id}}">{{#each spellcastingModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if usesFixedSpellcasting}}
                      {{#if hasAttack}}<label><span>Fixed Spell Attack Bonus</span><input type="number" min="-20" max="40" step="1" value="{{fixedAttackBonus}}" data-granted-spell-input="fixedAttackBonus" data-spell-id="{{id}}" data-value-type="number"></label>{{/if}}
                      {{#if hasSave}}<label><span>Fixed Spell Save DC</span><input type="number" min="1" max="40" step="1" value="{{fixedSaveDc}}" data-granted-spell-input="fixedSaveDc" data-spell-id="{{id}}" data-value-type="number"></label>{{/if}}
                      {{#unless hasAttack}}{{#unless hasSave}}<small class="ic-field-note">This Spell has no detected Spell Attack or Saving Throw, so fixed attack and DC values are not required.</small>{{/unless}}{{/unless}}
                    {{else}}
                    <small class="ic-field-note">Actor Default, Highest Spellcasting, or Intelligence/Wisdom/Charisma + Proficiency can support both spellcasters and non-spellcasters.</small>
                    {{/if}}
                  </section>

                  <section class="ic-spell-config-panel">
                    <h4>Availability</h4>
                    <label><span>Available While</span><select data-granted-spell-input="availability" data-spell-id="{{id}}">{{#each availabilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="ic-checkbox-line">
                      <input type="checkbox" data-granted-spell-input="showInSpellbook" data-spell-id="{{id}}" {{#if showInSpellbook}}checked{{/if}}>
                      <span><strong>Show Granted Spell in Spellbook</strong><small>Expose the linked Spell in the Actor spellbook while the item grants it.</small></span>
                    </label>
                  </section>
                </div>
              </article>
              {{/each}}
            </div>
            {{else}}
            <div class="ic-spell-empty-state">
              <i class="fa-solid fa-book-open"></i>
              <strong>No Spells added</strong>
              <p>Drop a Spell above or use Browse Spells. An enabled Granted Spellcasting card requires at least one valid Spell.</p>
            </div>
            {{/if}}
          {{/if}}
        </section>
      </section>


      <section class="ic-enhancement-group ic-resource-modification-group">
        <header>
          <span class="ic-kicker">Character Power</span>
          <h3>Resource Modifications</h3>
          <p>Each entry is independent. Class and subclass resources only apply when the Actor already owns the matching feature; global Spell Slots and Pact Magic can be granted directly.</p>
        </header>

        {{#if resourceModificationRows.length}}
        <div class="ic-resource-modification-list {{#if spellsResourcesErrors.resourceModifications}}invalid{{/if}}">
          {{#each resourceModificationRows}}
          <article class="ic-resource-modification-card {{#if invalid}}invalid{{/if}}" data-resource-id="{{id}}">
            <header>
              <div>
                <strong>Resource Modification {{index}}</strong>
                <small>{{summary}}</small>
              </div>
              <button type="button" class="ic-icon-button danger" data-action="remove-resource-modification" data-resource-id="{{id}}" aria-label="Remove resource modification" title="Remove Resource Modification"><i class="fa-solid fa-trash"></i></button>
            </header>

            <div class="ic-resource-modification-fields">
              <label><span>Resource Type</span><select data-resource-input="category" data-resource-id="{{id}}">{{#each categoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>

              {{#if isFeature}}
              <label class="ic-resource-wide"><span>Class / Subclass Resource</span><select data-resource-input="resourceId" data-resource-id="{{id}}">{{#each resourceGroups}}<optgroup label="{{label}}">{{#each items}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}</select></label>
              <label><span>Amount</span><input type="number" min="1" max="99" step="1" value="{{amount}}" data-resource-input="amount" data-resource-id="{{id}}" data-value-type="number"></label>
              <aside class="ic-resource-result"><i class="fa-solid fa-circle-info"></i><span>{{#if (eq amountMultiplier 1)}}Adds the selected amount to the existing {{unit}} pool.{{else}}Each +1 grants +{{amountMultiplier}} {{unit}}.{{/if}} The original feature controls spending and recovery.</span></aside>
              {{/if}}

              {{#if isResourceDie}}
              <label class="ic-resource-wide"><span>Resource Die</span><select data-resource-input="resourceId" data-resource-id="{{id}}">{{#each resourceGroups}}<optgroup label="{{label}}">{{#each items}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}</select></label>
              <label><span>Operation</span><select data-resource-input="operation" data-resource-id="{{id}}">{{#each dieOperationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{#if (eq operation "increaseSteps")}}<label><span>Die Steps</span><input type="number" min="1" max="5" step="1" value="{{amount}}" data-resource-input="amount" data-resource-id="{{id}}" data-value-type="number"></label>{{else}}<label><span>Die</span><select data-resource-input="die" data-resource-id="{{id}}" data-value-type="number">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
              <aside class="ic-resource-result"><i class="fa-solid fa-dice-d20"></i><span>The resource must already exist on the Actor. Minimum mode never reduces a naturally larger die.</span></aside>
              {{/if}}

              {{#if isSpellSlot}}
              <label><span>Spell Level</span><select data-resource-input="spellLevel" data-resource-id="{{id}}" data-value-type="number">{{#each spellLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label><span>Additional Slots</span><input type="number" min="1" max="9" step="1" value="{{amount}}" data-resource-input="amount" data-resource-id="{{id}}" data-value-type="number"></label>
              <aside class="ic-resource-result"><i class="fa-solid fa-hat-wizard"></i><span>Adds to the Actor's maximum slots at the selected circle. It does not grant known or prepared Spells.</span></aside>
              {{/if}}

              {{#if isPactSlot}}
              <label><span>Additional Pact Slots</span><input type="number" min="1" max="9" step="1" value="{{amount}}" data-resource-input="amount" data-resource-id="{{id}}" data-value-type="number"></label>
              <aside class="ic-resource-result"><i class="fa-solid fa-moon"></i><span>Adds to the existing Pact Magic pool. Pact slot level and recovery continue to follow the Actor's Warlock progression.</span></aside>
              {{/if}}

              <label><span>Active While</span><select data-resource-input="availability" data-resource-id="{{id}}">{{#each availabilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label class="ic-checkbox-line ic-resource-unlock"><input type="checkbox" data-resource-input="unlockOnLevel" data-resource-id="{{id}}" {{#if unlockOnLevel}}checked{{/if}}><span><strong>Unlock on Character Level</strong><small>Use total Actor level, regardless of class split.</small></span></label>
              {{#if unlockOnLevel}}<label><span>Character Level</span><input type="number" min="1" max="20" step="1" value="{{unlockLevel}}" data-resource-input="unlockLevel" data-resource-id="{{id}}" data-value-type="number"></label>{{/if}}
            </div>
          </article>
          {{/each}}
        </div>
        {{else}}
        <div class="ic-resource-empty-state"><i class="fa-solid fa-battery-half"></i><strong>No resource modifications</strong><p>Add a class resource, resource die, Spell Slot, or Pact Magic modification.</p></div>
        {{/if}}

        <button type="button" class="ic-add-resource-modification" data-action="add-resource-modification"><i class="fa-solid fa-plus"></i> Add Resource Modification</button>
      </section>
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless spellsResourcesComplete}}disabled{{/unless}}><span>Description</span><i class="fa-solid fa-chevron-right"></i></button>
    </footer>
    {{/if}}

    {{#if (eq step "description")}}
    <section class="ic-step-content ic-description-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Item Presentation</span>
          <h2>Description</h2>
          <p>The flavor description is inherited only from the selected Template. Item Creator appends generated Item Properties and the complete Level Progression below that flavor text.</p>
        </div>
      </header>

      <section class="ic-description-card">
        <header class="ic-description-source">
          <div>
            <span class="ic-kicker">Template Description</span>
            <h3>{{selectedWeapon.name}}</h3>
            <p>{{descriptionSource}}</p>
          </div>
          <span class="ic-support-badge native"><i class="fa-solid fa-filter"></i> Clean inherited preview</span>
        </header>

        <label class="ic-description-toggle">
          <input type="checkbox" data-description-toggle {{#if descriptionCustomized}}checked{{/if}}>
          <span>
            <strong>Customize Description</strong>
            <small>Enable the Foundry rich-text editor with the complete original Template description as the starting text. The physical base item never contributes separate description content.</small>
          </span>
        </label>

        {{#if descriptionCustomized}}
        <div class="ic-description-editor-shell" data-description-editor-host aria-label="Item description editor"></div>
        {{else}}
        <div class="editor editor-content ic-description-preview {{#unless hasTemplateDescription}}empty{{/unless}}">
          {{#if hasTemplateDescription}}
          {{{enrichedDescription}}}
          {{else}}
          <div class="ic-description-empty">
            <i class="fa-solid fa-align-left"></i>
            <strong>This Template has no description.</strong>
            <p>Enable Customize Description to write the final item text manually.</p>
          </div>
          {{/if}}
        </div>
        {{/if}}

        <aside class="ic-description-note">
          <i class="fa-solid fa-circle-info"></i>
          <p>Inherited preview mode conservatively removes recognized leading Template metadata. Customize mode loads the complete original Template HTML into Foundry’s native editor. Generated Item Properties and Level Progression are appended below the flavor text when the Item is built and are regenerated without duplication on later edits.</p>
        </aside>
      </section>
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless descriptionComplete}}disabled{{/unless}}><span>Review</span><i class="fa-solid fa-chevron-right"></i></button>
    </footer>
    {{/if}}

    {{#if (eq step "review")}}
    <section class="ic-step-content ic-review-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Final Validation</span>
          <h2>Review Item</h2>
          <p>{{#if editMode}}Review the native-style chat presentation and compact inventory appearance before updating the original World Item or saving the current configuration as a new copy.{{else}}Review the native-style chat presentation and the compact inventory appearance before creating the Item in the world Items Directory.{{/if}}</p>
        </div>
      </header>

      {{#if reviewError}}
      <aside class="ic-review-error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div><strong>Preview could not be built</strong><p>{{reviewError}}</p></div>
      </aside>
      {{else}}
      <div class="ic-review-preview-grid">
        <section class="ic-review-panel ic-chat-preview-panel">
          <header><span class="ic-kicker">Chat Presentation</span><h3>Native Item Card</h3></header>
          <div class="ic-native-chat-preview">{{{reviewChatCard}}}</div>
        </section>

        <section class="ic-review-panel ic-inventory-preview-panel">
          <header><span class="ic-kicker">Inventory Presentation</span><h3>Item Card</h3></header>
          {{#if reviewInventory}}
          <article class="ic-inventory-card">
            <img src="{{reviewInventory.img}}" alt="{{reviewInventory.name}}">
            <div class="ic-inventory-main">
              <div class="ic-inventory-title"><strong>{{reviewInventory.name}}</strong>{{#if reviewInventory.magical}}<i class="fa-solid fa-sparkles" title="Magical"></i>{{/if}}</div>
              <p>{{reviewInventory.type}} · {{reviewInventory.rarity}}</p>
              <dl>
                {{#if isWeapon}}<div><dt>Damage</dt><dd>{{reviewInventory.damage}}</dd></div>{{else if isEquipment}}<div><dt>Equipment Type</dt><dd>{{reviewInventory.equipmentType}}</dd></div>{{#if reviewInventory.armor}}<div><dt>Armor Class</dt><dd>{{reviewInventory.armor}}</dd></div>{{/if}}{{else if isTool}}<div><dt>Tool Category</dt><dd>{{reviewInventory.toolType}}</dd></div><div><dt>Tool Check Bonus</dt><dd>{{reviewInventory.toolBonus}}</dd></div>{{/if}}
                <div><dt>Attunement</dt><dd>{{reviewInventory.attunement}}</dd></div>
                <div><dt>Price</dt><dd>{{reviewInventory.price}} <small>({{reviewInventory.priceMode}})</small></dd></div>
                <div><dt>Quantity</dt><dd>{{reviewInventory.quantity}}</dd></div>
                <div><dt>Effects</dt><dd>{{reviewInventory.effects}}</dd></div>
              </dl>
              {{#if reviewInventory.properties.length}}
              <div class="ic-inventory-tags">{{#each reviewInventory.properties}}<span>{{this}}</span>{{/each}}</div>
              {{/if}}
            </div>
          </article>

          <div class="ic-review-activities">
            <h4>Activities</h4>
            {{#if reviewInventory.activities.length}}
              {{#each reviewInventory.activities}}
              <div class="ic-review-activity"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{type}}</small></span></div>
              {{/each}}
            {{else}}
              <p>No Activities are configured.</p>
            {{/if}}
          </div>
          {{/if}}
        </section>
      </div>

      <section class="ic-review-summary">
        <header><span class="ic-kicker">Configuration Summary</span><h3>Final Draft</h3></header>
        <dl>
          <div><dt>{{#if isWeapon}}Template{{else}}Base Item{{/if}}</dt><dd>{{reviewSummary.template}}</dd></div>
          <div><dt>{{#if isWeapon}}Base Weapon{{else if isEquipment}}Equipment Form{{else}}Tool Category{{/if}}</dt><dd>{{reviewSummary.baseWeapon}}</dd></div>
          <div><dt>Final Name</dt><dd>{{reviewSummary.name}}</dd></div>
          <div><dt>Base Overrides</dt><dd>{{reviewSummary.baseOverrides}}</dd></div>
          <div><dt>Enhancements</dt><dd>{{reviewSummary.enhancements}}</dd></div>
          <div><dt>Granted Spells</dt><dd>{{reviewSummary.grantedSpells}}</dd></div>
          <div><dt>Resource Modifications</dt><dd>{{reviewSummary.resources}}</dd></div>
          <div><dt>Granted Effects</dt><dd>{{reviewSummary.grantedEffects}}</dd></div>
          <div><dt>Triggered Effects</dt><dd>{{reviewSummary.triggeredEffects}}</dd></div>
          <div><dt>Converted Base Properties</dt><dd>{{reviewSummary.convertedProperties}}</dd></div>
          <div><dt>Custom Imported Data</dt><dd>{{reviewSummary.importedCustom}}</dd></div>
          <div><dt>Level Progressions</dt><dd>{{reviewSummary.progressions}}</dd></div>
          <div><dt>Description</dt><dd>{{reviewSummary.description}}</dd></div>
        </dl>

        {{#if convertedImportedSummary.length}}
        <section class="ic-review-import-breakdown">
          <header><strong>Imported and Converted Properties</strong><small>Native mechanics translated into editable Item Creator fields.</small></header>
          <ul>{{#each convertedImportedSummary}}<li>{{this}}</li>{{/each}}</ul>
        </section>
        {{/if}}

        {{#if reviewImportedEffects.length}}
        <section class="ic-review-import-breakdown">
          <header><strong>Custom Imported Effects</strong><small>Unrecognized Effect data rebuilt as normalized custom Effects.</small></header>
          <ul>{{#each reviewImportedEffects}}<li><strong>{{name}}</strong> — {{summary}}{{#if disabled}} (disabled){{/if}}</li>{{/each}}</ul>
        </section>
        {{/if}}

        {{#if reviewImportedActivities.length}}
        <section class="ic-review-import-breakdown">
          <header><strong>Custom Imported Activities</strong><small>Unrecognized Activities rebuilt from their technical source.</small></header>
          <ul>{{#each reviewImportedActivities}}<li><strong>{{name}}</strong> — {{summary}}{{#if disabled}} (excluded from final Item){{/if}}</li>{{/each}}</ul>
        </section>
        {{/if}}

        <section class="ic-review-import-breakdown">
          <header><strong>New Creator Properties</strong><small>Enhancements, passive and triggered effects, Granted Spells, and Resource Modifications configured in this draft.</small></header>
          <p>{{reviewSummary.enhancements}} Enhancement(s), {{reviewSummary.grantedEffects}} Granted Effect(s), {{reviewSummary.triggeredEffects}} Triggered Effect(s), {{reviewSummary.grantedSpells}} Granted Spell(s), and {{reviewSummary.resources}} Resource Modification(s).</p>
        </section>

        <aside><i class="fa-solid fa-circle-info"></i><p>{{#if editMode}}Update Item modifies the selected World Item in place. Save as Copy creates a separate World Item and leaves the original unchanged. Existing copies already placed on Actors are not automatically updated.{{else}}Save Item creates a new world Item. Return to any previous step to revise the name or configuration; existing draft selections are preserved.{{/if}}</p></aside>
      </section>
      {{/if}}
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      {{#if editMode}}
      <div class="ic-edit-save-actions">
        <button type="button" class="ic-save-copy" data-action="save-copy" {{#unless reviewReady}}disabled{{/unless}}>
          <i class="fa-solid fa-copy"></i><span>{{#if savingItem}}Working…{{else}}Save as Copy{{/if}}</span>
        </button>
        <button type="button" class="ic-primary-continue ic-save-item" data-action="update-item" {{#unless reviewReady}}disabled{{/unless}}>
          <i class="fa-solid fa-floppy-disk"></i><span>{{#if savingItem}}Updating…{{else}}Update Item{{/if}}</span>
        </button>
      </div>
      {{else}}
      <button type="button" class="ic-primary-continue ic-save-item" data-action="save-item" {{#unless reviewReady}}disabled{{/unless}}>
        <i class="fa-solid fa-floppy-disk"></i><span>{{#if savingItem}}Creating…{{else}}Save Item{{/if}}</span>
      </button>
      {{/if}}
    </footer>
    {{/if}}

  </main>
</div>
