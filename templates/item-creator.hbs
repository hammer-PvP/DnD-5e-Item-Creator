          </section>

          <section class="ic-enhancement-card {{#if enhancement.damageBonus}}enabled{{/if}} {{#if enhancementErrors.damageBonus}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="damageBonus" {{#if enhancement.damageBonus}}checked{{/if}}>
