            <section class="ic-override-card {{#if custom.proficiency}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-override-toggle="proficiency" {{#if custom.proficiency}}checked{{/if}}><span><strong>Customize Proficiency Handling</strong><small>Automatic uses the Actor's Tool proficiency; fixed options override it.</small></span></label><select data-override-input="proficiency" {{#unless custom.proficiency}}disabled{{/unless}}>{{#each proficiencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></section>
