            <section class="ic-override-card {{#if custom.strength}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-override-toggle="strength" {{#if custom.strength}}checked{{/if}}><span><strong>Customize Strength Requirement</strong><small>Set 0 for no requirement.</small></span></label><input type="number" min="0" step="1" value="{{effective.strength}}" data-override-input="strength" data-value-type="number" {{#unless custom.strength}}disabled{{/unless}}></section>
