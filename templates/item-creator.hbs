<div class="ic-shell">
  <aside class="ic-sidebar">
    <header class="ic-app-header">
      <i class="fa-solid fa-hammer"></i>
      <div>
        <h1>Item Creator</h1>
        <p>v{{version}} · {{stage}}</p>
      </div>
    </header>

    {{#if editMode}}
    <section class="ic-edit-mode-banner">
      <i class="fa-solid fa-pen-to-square"></i>
      <span>
        <small>Editing World Item</small>
        <strong>{{editingItemName}}</strong>
        <em>{{#if editingManagedItem}}Full Item Creator draft restored{{else}}Native D&D5e data imported{{/if}}</em>
      </span>
    </section>
    {{/if}}

    <nav class="ic-steps" aria-label="Item creation steps">
      {{#each steps}}
      <button type="button"
              class="ic-step {{#if active}}active{{/if}} {{#if complete}}complete{{/if}} {{#if locked}}locked{{/if}}"
              data-action="step" data-step="{{id}}" data-locked="{{locked}}" {{#if locked}}disabled{{/if}}>
        <i class="fa-solid {{#if complete}}fa-circle-check{{else if locked}}fa-lock{{else}}{{icon}}{{/if}}"></i>
        <span>{{label}}</span>
        {{#unless available}}<small>Coming Later</small>{{/unless}}
      </button>
      {{/each}}
    </nav>

    <section class="ic-draft-summary">
      <h3>Current Draft</h3>
      <p><strong>Type:</strong> {{#if selectedType}}{{itemTypeLabel}}{{else}}—{{/if}}</p>
      <p><strong>{{#if isWeapon}}Template{{else}}Base Item{{/if}}:</strong> {{#if selectedWeapon}}{{selectedWeapon.name}}{{else}}—{{/if}}</p>
      {{#if isWeapon}}<p><strong>Base Weapon:</strong> {{#if selectedBaseWeapon}}{{selectedBaseWeapon.name}}{{else if selectedWeapon}}Required{{else}}—{{/if}}</p>{{else if isEquipment}}<p><strong>Equipment Form:</strong> {{equipmentFormLabel}}</p>{{else if isTool}}<p><strong>Tool Category:</strong> {{reviewSummary.baseWeapon}}</p>{{/if}}
      <p><strong>Name:</strong> <span data-draft-name>{{#if itemName}}{{itemName}}{{else}}—{{/if}}</span></p>
      <p><strong>Custom Fields:</strong> {{customFieldCount}}</p>
      {{#if custom.additionalDamage}}<p><strong>Extra Damage:</strong> {{additionalDamageCount}} part(s)</p>{{/if}}
      {{#if enhancement.grantedSpellcasting}}<p><strong>Granted Spells:</strong> {{grantedSpellCount}}</p>{{/if}}
      <p><strong>Enhancements:</strong> {{enhancementCount}}</p>
      <p><strong>Granted Effects:</strong> {{grantedEffectCount}}</p>
      <p><strong>Imported Custom:</strong> {{importedCustomCount}}</p>
      <p><strong>Level Progressions:</strong> {{levelProgressionCount}}</p>
      <p><strong>Description:</strong> {{#if descriptionCustomized}}Custom{{else if hasTemplateDescription}}Template{{else}}Empty{{/if}}</p>
      <p><strong>Status:</strong> {{#if reviewReady}}{{readyStatus}}{{else}}Beta draft{{/if}}</p>
    </section>
  </aside>

  <main class="ic-main">
    {{#if (eq step "itemType")}}
    <section class="ic-step-content">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Assisted Item Creation</span>
          <h2>Choose Item Type</h2>
          <p>Create Weapons, Equipment, and Tools with the assisted workflow, create native Spell Scrolls, or open the optional Supplier stock generator from this unified entry point.</p>
        </div>
      </header>

      <div class="ic-type-grid">
        {{#each itemTypes}}
        <button type="button"
                class="ic-type-card {{#if selected}}selected{{/if}} {{#unless available}}unavailable{{/unless}}"
                data-action="select-type" data-type="{{id}}" data-available="{{available}}" {{#unless available}}disabled{{/unless}}>
          <i class="fa-solid {{icon}}"></i>
          <span>
            <strong>{{label}}</strong>
            <small>{{#if available}}Available{{else}}Coming Later{{/if}}</small>
          </span>
          {{#if selected}}<i class="fa-solid fa-circle-check ic-card-status"></i>{{/if}}
        </button>
        {{/each}}
      </div>

      <aside class="ic-alpha-note">
        <i class="fa-solid fa-flask"></i>
        <div>
          <strong>v{{version}} Beta flow</strong>
          <p>This Beta unifies Weapon, Equipment, Tool, Scroll Factory, Supplier, and the shared Materialization Core. Supplier appears here only when enabled in Item Creator Configuration.</p>
        </div>
      </aside>
    </section>

    <footer class="ic-navigation">
      <span></span>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless canOpenBaseItem}}disabled{{/unless}}>
        <span>Continue</span><i class="fa-solid fa-chevron-right"></i>
      </button>
    </footer>
    {{/if}}

    {{#if (eq step "baseItem")}}
    <section class="ic-step-content ic-base-step">
      {{#if isWeapon}}
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Weapon Creation</span>
          <h2>Base Item</h2>
          <p>Load a special Template through the native D&D5e Compendium Browser or the manual selectors, then confirm its physical Base Weapon. Core fields inherit from the Base Weapon unless you enable an override.</p>
        </div>
      </header>

      <section class="ic-template-panel">
        <header>
          <div>
            <span class="ic-kicker">Template</span>
            <h3>Choose a Starting Model</h3>
          </div>
          <small><strong data-template-count>{{weaponCount}}</strong> matching templates</small>
        </header>

        <div class="ic-template-browser-entry">
          <button type="button" class="ic-browse-template-button" data-action="browse-templates">
            <i class="fa-solid fa-books"></i>
            <span>
              <strong>Browse Weapon Templates</strong>
              <small>Open the native D&D5e Compendium Browser, already restricted to Weapon Items.</small>
            </span>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>

        <div class="ic-manual-template-divider"><span>or select manually</span></div>

        <div class="ic-template-controls ic-template-manual-controls">
          <label>
            <span>Weapon Type</span>
            <select data-template-category>
              {{#each templateCategoryOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="ic-template-select-field">
            <span>Template</span>
            <select data-template-select {{#unless weaponCount}}disabled{{/unless}}>
              <option value="">Select a weapon template…</option>
              {{#each templateOptionGroups}}
              <optgroup label="{{label}}">
                {{#each items}}
                <option value="{{uuid}}" data-template-option data-category="{{templateCategory}}" {{#if selected}}selected{{/if}}>{{optionLabel}}</option>
                {{/each}}
              </optgroup>
              {{/each}}
            </select>
          </label>
        </div>
      </section>

      {{#if selectedWeapon}}
      <div class="ic-base-form-layout">
        <section class="ic-identity-panel">
          <header>
            <span class="ic-kicker">Identity</span>
            <h3>Item Identity</h3>
          </header>

          <div class="ic-template-summary">
            <button type="button" class="ic-icon-button {{#unless iconCustomized}}locked{{/unless}}" data-action="open-icon-browser"
                    title="{{#if iconCustomized}}Open Icon Selection{{else}}Enable Customize Icon to choose another image{{/if}}"
                    aria-label="{{#if iconCustomized}}Open Icon Selection{{else}}Inherited template icon{{/if}}"
                    {{#unless iconCustomized}}disabled{{/unless}}>
              <img src="{{selectedWeapon.img}}" alt="{{selectedWeapon.name}}">
              <span aria-hidden="true"><i class="fa-solid {{#if iconCustomized}}fa-images{{else}}fa-link{{/if}}"></i></span>
            </button>
            <div>
              <strong>{{selectedWeapon.name}}</strong>
              <small>{{selectedWeapon.sourceLabel}}</small>
              <small>{{selectedWeapon.packLabel}}</small>
            </div>
          </div>

          {{#if selectedWeapon.importedMechanics.length}}
          <aside class="ic-imported-mechanics-summary">
            <strong><i class="fa-solid fa-arrows-rotate"></i> Imported Mechanics</strong>
            <ul>{{#each selectedWeapon.importedMechanics}}<li>{{this}}</li>{{/each}}</ul>
          </aside>
          {{/if}}

          <label class="ic-field">
            <span>Item Name</span>
            <input type="text" name="itemName" value="{{itemName}}" maxlength="120" autocomplete="off">
          </label>

          <label class="ic-identity-toggle">
            <input type="checkbox" data-override-toggle="icon" {{#if custom.icon}}checked{{/if}}>
            <span>
              <strong>Customize Icon</strong>
              <small>Enable the square icon button above to open the reusable Icon Selection browser.</small>
            </span>
          </label>

          <dl class="ic-template-metadata">
            <div><dt>Template Identifier</dt><dd>{{selectedWeapon.identifier}}</dd></div>
            <div><dt>Base Weapon</dt><dd>{{#if selectedBaseWeapon}}{{selectedBaseWeapon.name}}{{else}}Required{{/if}}</dd></div>
            <div><dt>Current Base Damage</dt><dd>{{selectedWeapon.damageSummary}}</dd></div>
            {{#if custom.additionalDamage}}
            <div><dt>Additional Damage Parts</dt><dd>{{additionalDamageCount}}</dd></div>
            {{/if}}
          </dl>
        </section>

        <section class="ic-core-panel">
          <header class="ic-core-header">
            <div>
              <span class="ic-kicker">Core Weapon Configuration</span>
              <h3>Inherited Fields</h3>
              <p>The Base Weapon supplies the physical statistics below. The selected Template remains the special model layered over it.</p>
            </div>

            <section class="ic-base-weapon-card {{#if baseWeaponCustomized}}enabled{{/if}} {{#if baseWeaponRequired}}required{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="baseWeapon" {{#if baseWeaponCustomized}}checked{{/if}} {{#if baseWeaponRequired}}disabled{{/if}}>
                <span>
                  <strong>{{#if baseWeaponRequired}}Select Base Weapon{{else}}Customize Base Weapon{{/if}}</strong>
                  <small>{{#if baseWeaponRequired}}This Template has no valid Base Item. Select the physical weapon before continuing.{{else}}Unchecked preserves the Base Weapon identified by the Template.{{/if}}</small>
                </span>
              </label>
              <select data-base-weapon-select {{#unless baseWeaponCustomized}}disabled{{/unless}} class="{{#if baseWeaponRequired}}{{#unless selectedBaseWeapon}}invalid{{/unless}}{{/if}}">
                <option value="">Select a base weapon…</option>
                {{#each baseWeaponOptionGroups}}
                <optgroup label="{{label}}">
                  {{#each items}}
                  <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{optionLabel}}</option>
                  {{/each}}
                </optgroup>
                {{/each}}
              </select>
              {{#if selectedBaseWeapon}}
              <small class="ic-base-weapon-meta"><strong>{{selectedBaseWeapon.identifier}}</strong> · {{selectedBaseWeapon.source}}</small>
              {{else if baseWeaponRequired}}
              <small class="ic-base-weapon-warning"><i class="fa-solid fa-triangle-exclamation"></i> Base Weapon selection is required.</small>
              {{/if}}
            </section>
          </header>

          <div class="ic-core-grid">
            <section class="ic-override-card {{#if custom.weaponType}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="weaponType" {{#if custom.weaponType}}checked{{/if}}>
                <span><strong>Customize Weapon Category</strong><small>Simple, Martial, Natural, Improvised, or Siege.</small></span>
              </label>
              <select data-override-input="weaponType" {{#unless custom.weaponType}}disabled{{/unless}}>
                {{#each weaponTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.attackType}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="attackType" {{#if custom.attackType}}checked{{/if}}>
                <span><strong>Customize Attack Type</strong><small>Controls whether the weapon attacks in melee or at range.</small></span>
              </label>
              <select data-override-input="attackType" {{#unless custom.attackType}}disabled{{/unless}}>
                {{#each attackTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.attackAbility}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="attackAbility" {{#if custom.attackAbility}}checked{{/if}}>
                <span><strong>Customize Attack Ability</strong><small>Allows Dexterity or another ability without adding Finesse.</small></span>
              </label>
              <select data-override-input="attackAbility" {{#unless custom.attackAbility}}disabled{{/unless}}>
                {{#each abilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.proficiency}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="proficiency" {{#if custom.proficiency}}checked{{/if}}>
                <span><strong>Customize Proficiency Handling</strong><small>Automatic follows the Actor's matching weapon proficiency.</small></span>
              </label>
              <select data-override-input="proficiency" {{#unless custom.proficiency}}disabled{{/unless}}>
                {{#each proficiencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card ic-span-two {{#if custom.baseDamage}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="baseDamage" {{#if custom.baseDamage}}checked{{/if}}>
                <span><strong>Customize Base Damage</strong><small>Changes the weapon's normal damage dice and flat bonus.</small></span>
              </label>
              <div class="ic-inline-fields ic-damage-fields">
                <label><span>Dice</span><input type="number" min="0" max="20" step="1" value="{{effective.baseDamage.number}}" data-override-input="baseDamage" data-override-part="number" data-value-type="number" {{#unless custom.baseDamage}}disabled{{/unless}}></label>
                <label><span>Die</span><select data-override-input="baseDamage" data-override-part="denomination" data-value-type="number" {{#unless custom.baseDamage}}disabled{{/unless}}>{{#each damageDiceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="ic-grow"><span>Flat Bonus</span><input type="text" value="{{effective.baseDamage.bonus}}" placeholder="0 or a formula" data-override-input="baseDamage" data-override-part="bonus" {{#unless custom.baseDamage}}disabled{{/unless}}></label>
              </div>
            </section>

            <section class="ic-override-card ic-span-two ic-additional-damage-card {{#if custom.additionalDamage}}enabled{{/if}} {{#unless additionalDamageValid}}invalid{{/unless}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="additionalDamage" {{#if custom.additionalDamage}}checked{{/if}}>
                <span><strong>Add Additional Damage</strong><small>Add one or more typed damage parts to the same native Attack Activity.</small></span>
              </label>

              {{#if custom.additionalDamage}}
              <div class="ic-additional-damage-list">
                {{#each additionalDamageRows}}
                <section class="ic-additional-damage-row">
                  <header>
                    <strong>Damage Part {{index}}</strong>
                    <small>{{summary}}</small>
                    <button type="button" data-action="remove-additional-damage" data-damage-id="{{id}}" aria-label="Remove damage part"><i class="fa-solid fa-trash"></i></button>
                  </header>
                  <div class="ic-additional-damage-fields">
                    <label><span>Dice</span><input type="number" min="1" max="20" step="1" value="{{number}}" data-extra-damage-input="number" data-damage-id="{{id}}" data-value-type="number"></label>
                    <label><span>Die</span><select data-extra-damage-input="denomination" data-damage-id="{{id}}" data-value-type="number">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="ic-grow"><span>Damage Type</span><select data-extra-damage-input="damageType" data-damage-id="{{id}}">{{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  </div>
                  <div class="ic-additional-ability-fields">
                    <label class="ic-additional-ability-toggle">
                      <input type="checkbox" data-extra-damage-input="useAbilityModifier" data-damage-id="{{id}}" {{#if useAbilityModifier}}checked{{/if}}>
                      <span>Add Ability Modifier</span>
                    </label>
                    <select data-extra-damage-input="ability" data-damage-id="{{id}}" {{#unless useAbilityModifier}}disabled{{/unless}}>
                      {{#each abilityModifierOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </div>
                </section>
                {{/each}}
              </div>
              <button type="button" class="ic-add-damage-button" data-action="add-additional-damage"><i class="fa-solid fa-plus"></i> Add Another Damage Part</button>
              {{else}}
              <p class="ic-disabled-feature-hint">Enable this option to configure damage such as 2d6 Fire, 1d4 Radiant, or 2d6 + Charisma Fire.</p>
              {{/if}}
            </section>

            <section class="ic-override-card {{#if custom.damageType}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="damageType" {{#if custom.damageType}}checked{{/if}}>
                <span><strong>Customize Base Damage Type</strong><small>Choose any damage type supported by D&D5e.</small></span>
              </label>
              <select data-override-input="damageType" {{#unless custom.damageType}}disabled{{/unless}}>
                {{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.mastery}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="mastery" {{#if custom.mastery}}checked{{/if}}>
                <span><strong>Customize Weapon Mastery</strong><small>Unchecked preserves the Mastery from the template.</small></span>
              </label>
              <select data-override-input="mastery" {{#unless custom.mastery}}disabled{{/unless}}>
                {{#each masteryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card ic-span-two {{#if custom.range}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="range" {{#if custom.range}}checked{{/if}}>
                <span><strong>Customize Range and Reach</strong><small>Normal range, long range, melee reach, and measurement unit.</small></span>
              </label>
              <div class="ic-inline-fields ic-range-fields">
                <label><span>Normal</span><input type="number" min="0" step="1" value="{{effective.range.value}}" data-override-input="range" data-override-part="value" data-value-type="number" {{#unless custom.range}}disabled{{/unless}}></label>
                <label><span>Long</span><input type="number" min="0" step="1" value="{{effective.range.long}}" data-override-input="range" data-override-part="long" data-value-type="number" {{#unless custom.range}}disabled{{/unless}}></label>
                <label><span>Reach</span><input type="number" min="0" step="1" value="{{effective.range.reach}}" data-override-input="range" data-override-part="reach" data-value-type="number" {{#unless custom.range}}disabled{{/unless}}></label>
                <label><span>Unit</span><select data-override-input="range" data-override-part="units" {{#unless custom.range}}disabled{{/unless}}>{{#each rangeUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </section>

            <section class="ic-override-card ic-span-two {{#if custom.properties}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="properties" {{#if custom.properties}}checked{{/if}}>
                <span><strong>Customize Weapon Properties</strong><small>Physical properties only. Magical configuration belongs to Enhancements.</small></span>
              </label>
              <div class="ic-property-grid">
                {{#each propertyOptions}}
                <label class="ic-property-option {{#if selected}}selected{{/if}}">
                  <input type="checkbox" data-property-key="{{value}}" {{#if selected}}checked{{/if}} {{#unless ../custom.properties}}disabled{{/unless}}>
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>

              {{#if hasVersatile}}
              <div class="ic-dependent-fields">
                <strong>Versatile Damage</strong>
                <div class="ic-inline-fields ic-damage-fields">
                  <label><span>Dice</span><input type="number" min="0" max="20" step="1" value="{{effective.versatile.number}}" data-override-input="versatile" data-override-parent="properties" data-override-part="number" data-value-type="number" {{#unless custom.properties}}disabled{{/unless}}></label>
                  <label><span>Die</span><select data-override-input="versatile" data-override-parent="properties" data-override-part="denomination" data-value-type="number" {{#unless custom.properties}}disabled{{/unless}}>{{#each versatileDiceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Damage Type</span><select data-override-input="versatile" data-override-parent="properties" data-override-part="damageType" {{#unless custom.properties}}disabled{{/unless}}>{{#each versatileDamageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label class="ic-grow"><span>Flat Bonus</span><input type="text" value="{{effective.versatile.bonus}}" data-override-input="versatile" data-override-parent="properties" data-override-part="bonus" {{#unless custom.properties}}disabled{{/unless}}></label>
                </div>
              </div>
              {{/if}}

              {{#if hasAmmunition}}
              <div class="ic-dependent-fields">
                <label class="ic-field"><span>Ammunition Type</span><input type="text" value="{{effective.ammunitionType}}" data-override-input="ammunitionType" data-override-parent="properties" {{#unless custom.properties}}disabled{{/unless}}></label>
              </div>
              {{/if}}
            </section>

            <section class="ic-override-card {{#if custom.weight}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="weight" {{#if custom.weight}}checked{{/if}}>
                <span><strong>Customize Weight</strong><small>Physical weight of one item.</small></span>
              </label>
              <div class="ic-inline-fields">
                <label class="ic-grow"><span>Value</span><input type="number" min="0" step="0.01" value="{{effective.weight.value}}" data-override-input="weight" data-override-part="value" data-value-type="number" {{#unless custom.weight}}disabled{{/unless}}></label>
                <label><span>Unit</span><select data-override-input="weight" data-override-part="units" {{#unless custom.weight}}disabled{{/unless}}>{{#each weightUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </section>

            <section class="ic-override-card {{#if custom.price}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="price" {{#if custom.price}}checked{{/if}}>
                <span><strong>Customize Price</strong><small>Base market value and currency denomination.</small></span>
              </label>
              <div class="ic-inline-fields">
                <label class="ic-grow"><span>Value</span><input type="number" min="0" step="0.01" value="{{effective.price.value}}" data-override-input="price" data-override-part="value" data-value-type="number" {{#unless custom.price}}disabled{{/unless}}></label>
                <label><span>Currency</span><select data-override-input="price" data-override-part="denomination" {{#unless custom.price}}disabled{{/unless}}>{{#each currencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </section>

            <section class="ic-override-card {{#if custom.quantity}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="quantity" {{#if custom.quantity}}checked{{/if}}>
                <span><strong>Customize Initial Quantity</strong><small>The number placed in the created Item stack.</small></span>
              </label>
              <input type="number" min="0" step="1" value="{{effective.quantity}}" data-override-input="quantity" data-value-type="number" {{#unless custom.quantity}}disabled{{/unless}}>
            </section>
          </div>
        </section>
      </div>
      {{else}}
      <div class="ic-empty-state ic-template-empty">
        <i class="fa-solid fa-khanda"></i>
        <strong>Choose a weapon template</strong>
        <p>Use the native D&D5e Compendium Browser or the manual dropdowns to load the starting name, icon, damage, properties, range, Mastery, weight, price, and other core values.</p>
      </div>
      {{/if}}
      {{else if isEquipment}}
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Equipment Creation</span>
          <h2>Base Item</h2>
          <p>Select an existing Equipment Item or start from a custom equipment shell. This step defines what the object physically is; its powers are configured later.</p>
        </div>
      </header>

      <section class="ic-template-panel">
