            <section class="ic-override-card {{#if custom.baseItem}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-override-toggle="baseItem" {{#if custom.baseItem}}checked{{/if}}><span><strong>Customize Base Tool</strong><small>Native D&amp;D5e base-tool identifier.</small></span></label><select data-override-input="baseItem" {{#unless custom.baseItem}}disabled{{/unless}}>{{#each baseToolOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></section>
