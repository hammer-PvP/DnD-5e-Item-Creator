<div class="ic-shell">
  <aside class="ic-sidebar">
    <header class="ic-app-header">
      <i class="fa-solid fa-hammer"></i>
      <div>
        <h1>Item Creator</h1>
        <p>v{{version}} · {{stage}}</p>
      </div>
    </header>

    <nav class="ic-steps" aria-label="Item creation steps">
      {{#each steps}}
      <button type="button"
              class="ic-step {{#if active}}active{{/if}} {{#if complete}}complete{{/if}} {{#if locked}}locked{{/if}}"
              data-action="step" data-step="{{id}}" data-locked="{{locked}}" {{#if locked}}disabled{{/if}}>
        <i class="fa-solid {{#if complete}}fa-circle-check{{else if locked}}fa-lock{{else}}{{icon}}{{/if}}"></i>
        <span>{{label}}</span>
        {{#unless available}}<small>Coming Later</small>{{/unless}}
      </button>
      {{/each}}
    </nav>

    <section class="ic-draft-summary">
      <h3>Current Draft</h3>
      <p><strong>Type:</strong> {{#if selectedType}}Weapon{{else}}—{{/if}}</p>
      <p><strong>Template:</strong> {{#if selectedWeapon}}{{selectedWeapon.name}}{{else}}—{{/if}}</p>
      <p><strong>Base Weapon:</strong> {{#if selectedBaseWeapon}}{{selectedBaseWeapon.name}}{{else if selectedWeapon}}Required{{else}}—{{/if}}</p>
      <p><strong>Name:</strong> <span data-draft-name>{{#if itemName}}{{itemName}}{{else}}—{{/if}}</span></p>
      <p><strong>Custom Fields:</strong> {{customFieldCount}}</p>
      {{#if custom.additionalDamage}}<p><strong>Extra Damage:</strong> {{additionalDamageCount}} part(s)</p>{{/if}}
      {{#if enhancement.grantedSpellcasting}}<p><strong>Granted Spells:</strong> {{grantedSpellCount}}</p>{{/if}}
      <p><strong>Enhancements:</strong> {{enhancementCount}}</p>
      <p><strong>Status:</strong> Alpha preview only</p>
    </section>
  </aside>

  <main class="ic-main">
    {{#if (eq step "itemType")}}
    <section class="ic-step-content">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Assisted Item Creation</span>
          <h2>Choose Item Type</h2>
          <p>Weapon is the first supported creation flow. Other document types will be added after Weapon is complete and validated.</p>
        </div>
      </header>

      <div class="ic-type-grid">
        {{#each itemTypes}}
        <button type="button"
                class="ic-type-card {{#if selected}}selected{{/if}} {{#unless available}}unavailable{{/unless}}"
                data-action="select-type" data-type="{{id}}" data-available="{{available}}" {{#unless available}}disabled{{/unless}}>
          <i class="fa-solid {{icon}}"></i>
          <span>
            <strong>{{label}}</strong>
            <small>{{#if available}}Available{{else}}Coming Later{{/if}}</small>
          </span>
          {{#if selected}}<i class="fa-solid fa-circle-check ic-card-status"></i>{{/if}}
        </button>
        {{/each}}
      </div>

      <aside class="ic-alpha-note">
        <i class="fa-solid fa-flask"></i>
        <div>
          <strong>v0.0.2 Alpha scope</strong>
          <p>This build adds configurable Granted Spellcasting with native Spell browsing, drag-and-drop, uses, recovery, spell-slot consumption, eligibility, cast level, spellcasting calculation, and availability. It does not create or modify Items.</p>
        </div>
      </aside>
    </section>

    <footer class="ic-navigation">
      <span></span>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless canOpenBaseItem}}disabled{{/unless}}>
        <span>Continue</span><i class="fa-solid fa-chevron-right"></i>
      </button>
    </footer>
    {{/if}}

    {{#if (eq step "baseItem")}}
    <section class="ic-step-content ic-base-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Weapon Creation</span>
          <h2>Base Item</h2>
          <p>Load a special Template through the native D&D5e Compendium Browser or the manual selectors, then confirm its physical Base Weapon. Core fields inherit from the Base Weapon unless you enable an override.</p>
        </div>
      </header>

      <section class="ic-template-panel">
        <header>
          <div>
            <span class="ic-kicker">Template</span>
            <h3>Choose a Starting Model</h3>
          </div>
          <small><strong data-template-count>{{weaponCount}}</strong> matching templates</small>
        </header>

        <div class="ic-template-browser-entry">
          <button type="button" class="ic-browse-template-button" data-action="browse-templates">
            <i class="fa-solid fa-books"></i>
            <span>
              <strong>Browse Weapon Templates</strong>
              <small>Open the native D&D5e Compendium Browser, already restricted to Weapon Items.</small>
            </span>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>

        <div class="ic-manual-template-divider"><span>or select manually</span></div>

        <div class="ic-template-controls ic-template-manual-controls">
          <label>
            <span>Weapon Type</span>
            <select data-template-category>
              {{#each templateCategoryOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="ic-template-select-field">
            <span>Template</span>
            <select data-template-select {{#unless templateOptions.length}}disabled{{/unless}}>
              <option value="">Select a weapon template…</option>
              {{#each templateOptions}}
              <option value="{{uuid}}" data-template-option data-category="{{weaponType}}" {{#if selected}}selected{{/if}}>{{optionLabel}}</option>
              {{/each}}
            </select>
          </label>
        </div>
      </section>

      {{#if selectedWeapon}}
      <div class="ic-base-form-layout">
        <section class="ic-identity-panel">
          <header>
            <span class="ic-kicker">Identity</span>
            <h3>Item Identity</h3>
          </header>

          <div class="ic-template-summary">
            <button type="button" class="ic-icon-button {{#unless iconCustomized}}locked{{/unless}}" data-action="open-icon-browser"
                    title="{{#if iconCustomized}}Open Icon Selection{{else}}Enable Customize Icon to choose another image{{/if}}"
                    aria-label="{{#if iconCustomized}}Open Icon Selection{{else}}Inherited template icon{{/if}}"
                    {{#unless iconCustomized}}disabled{{/unless}}>
              <img src="{{selectedWeapon.img}}" alt="{{selectedWeapon.name}}">
              <span aria-hidden="true"><i class="fa-solid {{#if iconCustomized}}fa-images{{else}}fa-link{{/if}}"></i></span>
            </button>
            <div>
              <strong>{{selectedWeapon.name}}</strong>
              <small>{{selectedWeapon.sourceLabel}}</small>
              <small>{{selectedWeapon.packLabel}}</small>
            </div>
          </div>

          <label class="ic-field">
            <span>Item Name</span>
            <input type="text" name="itemName" value="{{itemName}}" maxlength="120" autocomplete="off">
          </label>

          <label class="ic-identity-toggle">
            <input type="checkbox" data-override-toggle="icon" {{#if custom.icon}}checked{{/if}}>
            <span>
              <strong>Customize Icon</strong>
              <small>Enable the square icon button above to open the reusable Icon Selection browser.</small>
            </span>
          </label>

          <dl class="ic-template-metadata">
            <div><dt>Template Identifier</dt><dd>{{selectedWeapon.identifier}}</dd></div>
            <div><dt>Base Weapon</dt><dd>{{#if selectedBaseWeapon}}{{selectedBaseWeapon.name}}{{else}}Required{{/if}}</dd></div>
            <div><dt>Current Base Damage</dt><dd>{{selectedWeapon.damageSummary}}</dd></div>
            {{#if custom.additionalDamage}}
            <div><dt>Additional Damage Parts</dt><dd>{{additionalDamageCount}}</dd></div>
            {{/if}}
          </dl>
        </section>

        <section class="ic-core-panel">
          <header class="ic-core-header">
            <div>
              <span class="ic-kicker">Core Weapon Configuration</span>
              <h3>Inherited Fields</h3>
              <p>The Base Weapon supplies the physical statistics below. The selected Template remains the special model layered over it.</p>
            </div>

            <section class="ic-base-weapon-card {{#if baseWeaponCustomized}}enabled{{/if}} {{#if baseWeaponRequired}}required{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="baseWeapon" {{#if baseWeaponCustomized}}checked{{/if}} {{#if baseWeaponRequired}}disabled{{/if}}>
                <span>
                  <strong>{{#if baseWeaponRequired}}Select Base Weapon{{else}}Customize Base Weapon{{/if}}</strong>
                  <small>{{#if baseWeaponRequired}}This Template has no valid Base Item. Select the physical weapon before continuing.{{else}}Unchecked preserves the Base Weapon identified by the Template.{{/if}}</small>
                </span>
              </label>
              <select data-base-weapon-select {{#unless baseWeaponCustomized}}disabled{{/unless}} class="{{#if baseWeaponRequired}}{{#unless selectedBaseWeapon}}invalid{{/unless}}{{/if}}">
                <option value="">Select a base weapon…</option>
                {{#each baseWeaponOptions}}
                <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{optionLabel}}</option>
                {{/each}}
              </select>
              {{#if selectedBaseWeapon}}
              <small class="ic-base-weapon-meta"><strong>{{selectedBaseWeapon.identifier}}</strong> · {{selectedBaseWeapon.source}}</small>
              {{else if baseWeaponRequired}}
              <small class="ic-base-weapon-warning"><i class="fa-solid fa-triangle-exclamation"></i> Base Weapon selection is required.</small>
              {{/if}}
            </section>
          </header>

          <div class="ic-core-grid">
            <section class="ic-override-card {{#if custom.weaponType}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="weaponType" {{#if custom.weaponType}}checked{{/if}}>
                <span><strong>Customize Weapon Category</strong><small>Simple, Martial, Natural, Improvised, or Siege.</small></span>
              </label>
              <select data-override-input="weaponType" {{#unless custom.weaponType}}disabled{{/unless}}>
                {{#each weaponTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.attackType}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="attackType" {{#if custom.attackType}}checked{{/if}}>
                <span><strong>Customize Attack Type</strong><small>Controls whether the weapon attacks in melee or at range.</small></span>
              </label>
              <select data-override-input="attackType" {{#unless custom.attackType}}disabled{{/unless}}>
                {{#each attackTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.attackAbility}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="attackAbility" {{#if custom.attackAbility}}checked{{/if}}>
                <span><strong>Customize Attack Ability</strong><small>Allows Dexterity or another ability without adding Finesse.</small></span>
              </label>
              <select data-override-input="attackAbility" {{#unless custom.attackAbility}}disabled{{/unless}}>
                {{#each abilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.proficiency}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="proficiency" {{#if custom.proficiency}}checked{{/if}}>
                <span><strong>Customize Proficiency Handling</strong><small>Automatic follows the Actor's matching weapon proficiency.</small></span>
              </label>
              <select data-override-input="proficiency" {{#unless custom.proficiency}}disabled{{/unless}}>
                {{#each proficiencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card ic-span-two {{#if custom.baseDamage}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="baseDamage" {{#if custom.baseDamage}}checked{{/if}}>
                <span><strong>Customize Base Damage</strong><small>Changes the weapon's normal damage dice and flat bonus.</small></span>
              </label>
              <div class="ic-inline-fields ic-damage-fields">
                <label><span>Dice</span><input type="number" min="0" max="20" step="1" value="{{effective.baseDamage.number}}" data-override-input="baseDamage" data-override-part="number" data-value-type="number" {{#unless custom.baseDamage}}disabled{{/unless}}></label>
                <label><span>Die</span><select data-override-input="baseDamage" data-override-part="denomination" data-value-type="number" {{#unless custom.baseDamage}}disabled{{/unless}}>{{#each damageDiceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="ic-grow"><span>Flat Bonus</span><input type="text" value="{{effective.baseDamage.bonus}}" placeholder="0 or a formula" data-override-input="baseDamage" data-override-part="bonus" {{#unless custom.baseDamage}}disabled{{/unless}}></label>
              </div>
            </section>

            <section class="ic-override-card ic-span-two ic-additional-damage-card {{#if custom.additionalDamage}}enabled{{/if}} {{#unless additionalDamageValid}}invalid{{/unless}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="additionalDamage" {{#if custom.additionalDamage}}checked{{/if}}>
                <span><strong>Add Additional Damage</strong><small>Add one or more typed damage parts to the same native Attack Activity.</small></span>
              </label>

              {{#if custom.additionalDamage}}
              <div class="ic-additional-damage-list">
                {{#each additionalDamageRows}}
                <section class="ic-additional-damage-row">
                  <header>
                    <strong>Damage Part {{index}}</strong>
                    <small>{{summary}}</small>
                    <button type="button" data-action="remove-additional-damage" data-damage-id="{{id}}" aria-label="Remove damage part"><i class="fa-solid fa-trash"></i></button>
                  </header>
                  <div class="ic-additional-damage-fields">
                    <label><span>Dice</span><input type="number" min="1" max="20" step="1" value="{{number}}" data-extra-damage-input="number" data-damage-id="{{id}}" data-value-type="number"></label>
                    <label><span>Die</span><select data-extra-damage-input="denomination" data-damage-id="{{id}}" data-value-type="number">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="ic-grow"><span>Damage Type</span><select data-extra-damage-input="damageType" data-damage-id="{{id}}">{{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  </div>
                  <div class="ic-additional-ability-fields">
                    <label class="ic-additional-ability-toggle">
                      <input type="checkbox" data-extra-damage-input="useAbilityModifier" data-damage-id="{{id}}" {{#if useAbilityModifier}}checked{{/if}}>
                      <span>Add Ability Modifier</span>
                    </label>
                    <select data-extra-damage-input="ability" data-damage-id="{{id}}" {{#unless useAbilityModifier}}disabled{{/unless}}>
                      {{#each abilityModifierOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </div>
                </section>
                {{/each}}
              </div>
              <button type="button" class="ic-add-damage-button" data-action="add-additional-damage"><i class="fa-solid fa-plus"></i> Add Another Damage Part</button>
              {{else}}
              <p class="ic-disabled-feature-hint">Enable this option to configure damage such as 2d6 Fire, 1d4 Radiant, or 2d6 + Charisma Fire.</p>
              {{/if}}
            </section>

            <section class="ic-override-card {{#if custom.damageType}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="damageType" {{#if custom.damageType}}checked{{/if}}>
                <span><strong>Customize Base Damage Type</strong><small>Choose any damage type supported by D&D5e.</small></span>
              </label>
              <select data-override-input="damageType" {{#unless custom.damageType}}disabled{{/unless}}>
                {{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card {{#if custom.mastery}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="mastery" {{#if custom.mastery}}checked{{/if}}>
                <span><strong>Customize Weapon Mastery</strong><small>Unchecked preserves the Mastery from the template.</small></span>
              </label>
              <select data-override-input="mastery" {{#unless custom.mastery}}disabled{{/unless}}>
                {{#each masteryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </section>

            <section class="ic-override-card ic-span-two {{#if custom.range}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="range" {{#if custom.range}}checked{{/if}}>
                <span><strong>Customize Range and Reach</strong><small>Normal range, long range, melee reach, and measurement unit.</small></span>
              </label>
              <div class="ic-inline-fields ic-range-fields">
                <label><span>Normal</span><input type="number" min="0" step="1" value="{{effective.range.value}}" data-override-input="range" data-override-part="value" data-value-type="number" {{#unless custom.range}}disabled{{/unless}}></label>
                <label><span>Long</span><input type="number" min="0" step="1" value="{{effective.range.long}}" data-override-input="range" data-override-part="long" data-value-type="number" {{#unless custom.range}}disabled{{/unless}}></label>
                <label><span>Reach</span><input type="number" min="0" step="1" value="{{effective.range.reach}}" data-override-input="range" data-override-part="reach" data-value-type="number" {{#unless custom.range}}disabled{{/unless}}></label>
                <label><span>Unit</span><select data-override-input="range" data-override-part="units" {{#unless custom.range}}disabled{{/unless}}>{{#each rangeUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </section>

            <section class="ic-override-card ic-span-two {{#if custom.properties}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="properties" {{#if custom.properties}}checked{{/if}}>
                <span><strong>Customize Weapon Properties</strong><small>Physical properties only. Magical configuration belongs to Enhancements.</small></span>
              </label>
              <div class="ic-property-grid">
                {{#each propertyOptions}}
                <label class="ic-property-option {{#if selected}}selected{{/if}}">
                  <input type="checkbox" data-property-key="{{value}}" {{#if selected}}checked{{/if}} {{#unless ../custom.properties}}disabled{{/unless}}>
                  <span>{{label}}</span>
                </label>
                {{/each}}
              </div>

              {{#if hasVersatile}}
              <div class="ic-dependent-fields">
                <strong>Versatile Damage</strong>
                <div class="ic-inline-fields ic-damage-fields">
                  <label><span>Dice</span><input type="number" min="0" max="20" step="1" value="{{effective.versatile.number}}" data-override-input="versatile" data-override-parent="properties" data-override-part="number" data-value-type="number" {{#unless custom.properties}}disabled{{/unless}}></label>
                  <label><span>Die</span><select data-override-input="versatile" data-override-parent="properties" data-override-part="denomination" data-value-type="number" {{#unless custom.properties}}disabled{{/unless}}>{{#each versatileDiceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Damage Type</span><select data-override-input="versatile" data-override-parent="properties" data-override-part="damageType" {{#unless custom.properties}}disabled{{/unless}}>{{#each versatileDamageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label class="ic-grow"><span>Flat Bonus</span><input type="text" value="{{effective.versatile.bonus}}" data-override-input="versatile" data-override-parent="properties" data-override-part="bonus" {{#unless custom.properties}}disabled{{/unless}}></label>
                </div>
              </div>
              {{/if}}

              {{#if hasAmmunition}}
              <div class="ic-dependent-fields">
                <label class="ic-field"><span>Ammunition Type</span><input type="text" value="{{effective.ammunitionType}}" data-override-input="ammunitionType" data-override-parent="properties" {{#unless custom.properties}}disabled{{/unless}}></label>
              </div>
              {{/if}}
            </section>

            <section class="ic-override-card {{#if custom.weight}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="weight" {{#if custom.weight}}checked{{/if}}>
                <span><strong>Customize Weight</strong><small>Physical weight of one item.</small></span>
              </label>
              <div class="ic-inline-fields">
                <label class="ic-grow"><span>Value</span><input type="number" min="0" step="0.01" value="{{effective.weight.value}}" data-override-input="weight" data-override-part="value" data-value-type="number" {{#unless custom.weight}}disabled{{/unless}}></label>
                <label><span>Unit</span><select data-override-input="weight" data-override-part="units" {{#unless custom.weight}}disabled{{/unless}}>{{#each weightUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </section>

            <section class="ic-override-card {{#if custom.price}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="price" {{#if custom.price}}checked{{/if}}>
                <span><strong>Customize Price</strong><small>Base market value and currency denomination.</small></span>
              </label>
              <div class="ic-inline-fields">
                <label class="ic-grow"><span>Value</span><input type="number" min="0" step="0.01" value="{{effective.price.value}}" data-override-input="price" data-override-part="value" data-value-type="number" {{#unless custom.price}}disabled{{/unless}}></label>
                <label><span>Currency</span><select data-override-input="price" data-override-part="denomination" {{#unless custom.price}}disabled{{/unless}}>{{#each currencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              </div>
            </section>

            <section class="ic-override-card {{#if custom.quantity}}enabled{{/if}}">
              <label class="ic-override-heading">
                <input type="checkbox" data-override-toggle="quantity" {{#if custom.quantity}}checked{{/if}}>
                <span><strong>Customize Initial Quantity</strong><small>The number placed in the created Item stack.</small></span>
              </label>
              <input type="number" min="0" step="1" value="{{effective.quantity}}" data-override-input="quantity" data-value-type="number" {{#unless custom.quantity}}disabled{{/unless}}>
            </section>
          </div>
        </section>
      </div>
      {{else}}
      <div class="ic-empty-state ic-template-empty">
        <i class="fa-solid fa-khanda"></i>
        <strong>Choose a weapon template</strong>
        <p>Use the native D&D5e Compendium Browser or the manual dropdowns to load the starting name, icon, damage, properties, range, Mastery, weight, price, and other core values.</p>
      </div>
      {{/if}}
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless baseComplete}}disabled{{/unless}}>
        <span>Enhancements</span><i class="fa-solid fa-chevron-right"></i>
      </button>
    </footer>
    {{/if}}

    {{#if (eq step "enhancements")}}
    <section class="ic-step-content ic-enhancements-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Weapon Creation</span>
          <h2>Enhancements</h2>
          <p>Enable only the enhancements this weapon needs. Every card is optional, and disabling a card immediately discards its values without changing the selected Template or Base Weapon.</p>
        </div>
      </header>

      <aside class="ic-alpha-note ic-enhancement-note">
        <i class="fa-solid fa-layer-group"></i>
        <div>
          <strong>Template inheritance remains intact</strong>
          <p>Unchecked cards add no Item Creator override. Existing special properties from the selected Template remain a separate layer for the future controlled merge.</p>
        </div>
      </aside>

      <section class="ic-enhancement-group">
        <header>
          <span class="ic-kicker">Magical Configuration</span>
          <h3>Magical Nature and Enhancement</h3>
        </header>
        <div class="ic-enhancement-grid">
          <section class="ic-enhancement-card {{#if enhancement.magicalWeapon}}enabled{{/if}} {{#if enhancementErrors.magicalWeapon}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="magicalWeapon" {{#if enhancement.magicalWeapon}}checked{{/if}}>
              <span><strong>Magical Weapon</strong><small>Set magical rarity and attunement without requiring a numeric +1, +2, or +3 bonus.</small></span>
            </label>
            <div class="ic-enhancement-fields two-columns">
              <label><span>Rarity</span><select data-enhancement-input="magicalWeapon" data-enhancement-part="rarity" {{#unless enhancement.magicalWeapon}}disabled{{/unless}}>{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label><span>Attunement</span><select data-enhancement-input="magicalWeapon" data-enhancement-part="attunement" {{#unless enhancement.magicalWeapon}}disabled{{/unless}}>{{#each attunementOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </div>
          </section>

          <section class="ic-enhancement-card {{#if enhancement.weaponEnhancement}}enabled{{/if}} {{#if enhancementErrors.weaponEnhancement}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="weaponEnhancement" {{#if enhancement.weaponEnhancement}}checked{{/if}}>
              <span><strong>Weapon Enhancement</strong><small>Apply the classic matching bonus to Attack Rolls and Damage Rolls. This also makes the draft magical.</small></span>
            </label>
            <label class="ic-enhancement-field"><span>Enhancement Bonus</span><select data-enhancement-input="weaponEnhancement" data-enhancement-part="bonus" data-value-type="number" {{#unless enhancement.weaponEnhancement}}disabled{{/unless}}>{{#each enhancementBonusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{#if enhancement.weaponEnhancement}}<small class="ic-mechanical-note"><i class="fa-solid fa-wand-magic-sparkles"></i> The effective draft is treated as magical.</small>{{/if}}
          </section>
        </div>
      </section>

      <section class="ic-enhancement-group">
        <header>
          <span class="ic-kicker">Attack and Damage</span>
          <h3>Offensive Modifiers</h3>
        </header>
        <div class="ic-enhancement-grid">
          <section class="ic-enhancement-card {{#if enhancement.attackBonus}}enabled{{/if}} {{#if enhancementErrors.attackBonus}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="attackBonus" {{#if enhancement.attackBonus}}checked{{/if}}>
              <span><strong>Additional Attack Bonus</strong><small>Add a numeric bonus only to Attack Rolls made with this weapon.</small></span>
            </label>
            <label class="ic-enhancement-field"><span>Attack Bonus</span><input type="number" min="-20" max="20" step="1" value="{{enhancementValues.attackBonus.bonus}}" data-enhancement-input="attackBonus" data-enhancement-part="bonus" data-value-type="number" {{#unless enhancement.attackBonus}}disabled{{/unless}}></label>
          </section>

          <section class="ic-enhancement-card {{#if enhancement.damageBonus}}enabled{{/if}} {{#if enhancementErrors.damageBonus}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="damageBonus" {{#if enhancement.damageBonus}}checked{{/if}}>
              <span><strong>Additional Damage Bonus</strong><small>Add a flat numeric bonus to the weapon's normal damage without changing its Attack Roll.</small></span>
            </label>
            <label class="ic-enhancement-field"><span>Damage Bonus</span><input type="number" min="-20" max="20" step="1" value="{{enhancementValues.damageBonus.bonus}}" data-enhancement-input="damageBonus" data-enhancement-part="bonus" data-value-type="number" {{#unless enhancement.damageBonus}}disabled{{/unless}}></label>
          </section>

          <section class="ic-enhancement-card {{#if enhancement.criticalThreshold}}enabled{{/if}} {{#if enhancementErrors.criticalThreshold}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="criticalThreshold" {{#if enhancement.criticalThreshold}}checked{{/if}}>
              <span><strong>Critical Hit Threshold</strong><small>Choose the final d20 result that begins the weapon's critical range.</small></span>
            </label>
            <div class="ic-enhancement-fields {{#if (eq enhancementValues.criticalThreshold.mode "custom")}}two-columns{{/if}}">
              <label><span>Critical Hit On</span><select data-enhancement-input="criticalThreshold" data-enhancement-part="mode" {{#unless enhancement.criticalThreshold}}disabled{{/unless}}>{{#each criticalThresholdOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{#if (eq enhancementValues.criticalThreshold.mode "custom")}}<label><span>Custom Threshold</span><input type="number" min="1" max="20" step="1" value="{{enhancementValues.criticalThreshold.custom}}" data-enhancement-input="criticalThreshold" data-enhancement-part="custom" data-value-type="number" {{#unless enhancement.criticalThreshold}}disabled{{/unless}}></label>{{/if}}
            </div>
          </section>

          <section class="ic-enhancement-card {{#if enhancement.extraCriticalDamage}}enabled{{/if}} {{#if enhancementErrors.extraCriticalDamage}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="extraCriticalDamage" {{#if enhancement.extraCriticalDamage}}checked{{/if}}>
              <span><strong>Extra Critical Damage</strong><small>Add a separate typed damage die part only when this weapon scores a Critical Hit.</small></span>
            </label>
            <div class="ic-enhancement-fields critical-damage-fields">
              <label><span>Dice</span><input type="number" min="1" max="20" step="1" value="{{enhancementValues.extraCriticalDamage.number}}" data-enhancement-input="extraCriticalDamage" data-enhancement-part="number" data-value-type="number" {{#unless enhancement.extraCriticalDamage}}disabled{{/unless}}></label>
              <label><span>Die</span><select data-enhancement-input="extraCriticalDamage" data-enhancement-part="denomination" data-value-type="number" {{#unless enhancement.extraCriticalDamage}}disabled{{/unless}}>{{#each criticalDamageDiceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label><span>Damage Type</span><select data-enhancement-input="extraCriticalDamage" data-enhancement-part="damageType" {{#unless enhancement.extraCriticalDamage}}disabled{{/unless}}>{{#each criticalDamageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </div>
          </section>
        </div>
      </section>

      <section class="ic-enhancement-group ic-spellcasting-group">
        <header>
          <span class="ic-kicker">Granted Magic</span>
          <h3>Granted Spellcasting</h3>
        </header>
        <section class="ic-enhancement-card ic-span-two ic-granted-spellcasting-card {{#if enhancement.grantedSpellcasting}}enabled{{/if}} {{#if enhancementErrors.grantedSpellcasting}}invalid{{/if}}">
          <label class="ic-override-heading">
            <input type="checkbox" data-enhancement-toggle="grantedSpellcasting" {{#if enhancement.grantedSpellcasting}}checked{{/if}}>
            <span><strong>Granted Spellcasting</strong><small>Grant one or more Spells through this weapon. Each Spell has independent uses, recovery, slot consumption, eligibility, cast level, spellcasting calculation, spellbook visibility, and availability.</small></span>
          </label>

          <div class="ic-spell-drop-zone {{#unless enhancement.grantedSpellcasting}}disabled{{/unless}}" data-spell-drop-zone>
            <i class="fa-solid fa-wand-sparkles"></i>
            <div>
              <strong>Drop a Spell here</strong>
              <small>Drag a Spell Item from a compendium or directory, or use the native D&amp;D5e Spell Browser.</small>
            </div>
            <button type="button" data-action="browse-spells" {{#unless enhancement.grantedSpellcasting}}disabled{{/unless}}>
              <i class="fa-solid fa-books"></i> Browse Spells
            </button>
          </div>

          {{#if enhancement.grantedSpellcasting}}
            {{#if grantedSpellRows.length}}
            <div class="ic-granted-spell-list">
              {{#each grantedSpellRows}}
              <article class="ic-granted-spell {{#if invalid}}invalid{{/if}}" data-spell-id="{{id}}">
                <header class="ic-granted-spell-header">
                  <img src="{{img}}" alt="{{name}}">
                  <div>
                    <strong>{{name}}</strong>
                    <span>{{spellLevelLabel}} · {{schoolLabel}}</span>
                    <small>{{source}}</small>
                  </div>
                  <button type="button" class="ic-icon-button danger" data-action="remove-granted-spell" data-spell-id="{{id}}" aria-label="Remove {{name}}" title="Remove Spell">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </header>

                <div class="ic-spell-config-grid">
                  <section class="ic-spell-config-panel">
                    <h4>Uses and Recovery</h4>
                    <label><span>Use Limit</span><select data-granted-spell-input="useLimit" data-spell-id="{{id}}">{{#each useLimitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if isLimited}}
                    <div class="ic-spell-inline-fields">
                      <label><span>Maximum Uses</span><input type="number" min="1" max="99" step="1" value="{{maxUses}}" data-granted-spell-input="maxUses" data-spell-id="{{id}}" data-value-type="number"></label>
                      <label><span>Recovery</span><select data-granted-spell-input="recovery" data-spell-id="{{id}}">{{#each recoveryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    </div>
                    {{else}}
                    <small class="ic-field-note">Unlimited means the item has no charge limit. Spell-slot consumption can still limit actual use.</small>
                    {{/if}}
                    <label class="ic-checkbox-line {{#if isCantrip}}disabled{{/if}}">
                      <input type="checkbox" data-granted-spell-input="consumeSlot" data-spell-id="{{id}}" {{#if consumeSlot}}checked{{/if}} {{#if isCantrip}}disabled{{/if}}>
                      <span><strong>Consume a Spell Slot</strong><small>{{#if isCantrip}}Cantrips never consume spell slots.{{else}}Require and consume a compatible slot for every cast.{{/if}}</small></span>
                    </label>
                  </section>

                  <section class="ic-spell-config-panel">
                    <h4>Eligibility and Cast Level</h4>
                    <label><span>Casting Eligibility</span><select data-granted-spell-input="eligibility" data-spell-id="{{id}}" {{#if consumeSlot}}disabled{{/if}}>{{#each eligibilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if consumeSlot}}<small class="ic-field-note">Spell-slot consumption automatically requires a compatible spell slot.</small>{{/if}}
                    <label><span>Cast Level</span><select data-granted-spell-input="castLevelMode" data-spell-id="{{id}}">{{#each castLevelModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if (eq castLevelMode "fixed")}}
                    <label><span>Fixed Cast Level</span><select data-granted-spell-input="fixedCastLevel" data-spell-id="{{id}}" data-value-type="number">{{#each fixedCastLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{/if}}
                  </section>

                  <section class="ic-spell-config-panel ic-spellcasting-calculation">
                    <h4>Spellcasting Calculation</h4>
                    <label><span>Spellcasting</span><select data-granted-spell-input="spellcastingMode" data-spell-id="{{id}}">{{#each spellcastingModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if usesFixedSpellcasting}}
                      {{#if hasAttack}}<label><span>Fixed Spell Attack Bonus</span><input type="number" min="-20" max="40" step="1" value="{{fixedAttackBonus}}" data-granted-spell-input="fixedAttackBonus" data-spell-id="{{id}}" data-value-type="number"></label>{{/if}}
                      {{#if hasSave}}<label><span>Fixed Spell Save DC</span><input type="number" min="1" max="40" step="1" value="{{fixedSaveDc}}" data-granted-spell-input="fixedSaveDc" data-spell-id="{{id}}" data-value-type="number"></label>{{/if}}
                      {{#unless hasAttack}}{{#unless hasSave}}<small class="ic-field-note">This Spell has no detected Spell Attack or Saving Throw, so fixed attack and DC values are not required.</small>{{/unless}}{{/unless}}
                    {{else}}
                    <small class="ic-field-note">Actor Default, Highest Spellcasting, or Intelligence/Wisdom/Charisma + Proficiency can support both spellcasters and non-spellcasters.</small>
                    {{/if}}
                  </section>

                  <section class="ic-spell-config-panel">
                    <h4>Availability</h4>
                    <label><span>Available While</span><select data-granted-spell-input="availability" data-spell-id="{{id}}">{{#each availabilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="ic-checkbox-line">
                      <input type="checkbox" data-granted-spell-input="showInSpellbook" data-spell-id="{{id}}" {{#if showInSpellbook}}checked{{/if}}>
                      <span><strong>Show Granted Spell in Spellbook</strong><small>Expose the linked Spell in the Actor spellbook while the item grants it.</small></span>
                    </label>
                  </section>
                </div>
              </article>
              {{/each}}
            </div>
            {{else}}
            <div class="ic-spell-empty-state">
              <i class="fa-solid fa-book-open"></i>
              <strong>No Spells added</strong>
              <p>Drop a Spell above or use Browse Spells. An enabled Granted Spellcasting card requires at least one valid Spell.</p>
            </div>
            {{/if}}
          {{/if}}
        </section>
      </section>

      <section class="ic-enhancement-group">
        <header>
          <span class="ic-kicker">Advanced Combat Behavior</span>
          <h3>Runtime and Conditional Rules</h3>
        </header>
        <div class="ic-enhancement-grid">
          <section class="ic-enhancement-card ic-span-two {{#if enhancement.ignoreResistance}}enabled{{/if}} {{#if enhancementErrors.ignoreResistance}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="ignoreResistance" {{#if enhancement.ignoreResistance}}checked{{/if}}>
              <span><strong>Ignore Damage Resistance</strong><small>Damage of the selected types from this weapon ignores resistance, but not immunity.</small></span>
            </label>
            <span class="ic-support-badge runtime"><i class="fa-solid fa-microchip"></i> Item Creator Runtime</span>
            <div class="ic-resistance-grid">
              {{#each resistanceDamageTypes}}
              <label class="ic-property-option {{#if selected}}selected{{/if}}">
                <input type="checkbox" data-resistance-type="{{value}}" {{#if selected}}checked{{/if}} {{#unless ../enhancement.ignoreResistance}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
          </section>

          <section class="ic-enhancement-card ic-span-two {{#if enhancement.conditionalAdvantage}}enabled{{/if}} {{#if enhancementErrors.conditionalAdvantage}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="conditionalAdvantage" {{#if enhancement.conditionalAdvantage}}checked{{/if}}>
              <span><strong>Conditional Advantage</strong><small>Grant Advantage on Attack Rolls with this weapon under a supported condition, or record a custom descriptive rule.</small></span>
            </label>
            <span class="ic-support-badge {{#if conditionalIsSupported}}runtime{{else}}description{{/if}}"><i class="fa-solid {{#if conditionalIsSupported}}fa-microchip{{else}}fa-align-left{{/if}}"></i> {{conditionalSupportLabel}}</span>
            <div class="ic-enhancement-fields conditional-fields">
              <label><span>Condition Type</span><select data-enhancement-input="conditionalAdvantage" data-enhancement-part="mode" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{#each conditionalModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label><span>Applies To</span><select data-enhancement-input="conditionalAdvantage" data-enhancement-part="appliesTo" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{#each conditionalAppliesToOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{#if conditionalIsSupported}}
              <label class="ic-span-two"><span>Supported Condition</span><select data-enhancement-input="conditionalAdvantage" data-enhancement-part="supportedCondition" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{#each supportedConditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{else}}
              <label class="ic-span-two"><span>Custom Rule Text</span><textarea rows="3" maxlength="500" data-enhancement-input="conditionalAdvantage" data-enhancement-part="customText" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{enhancementValues.conditionalAdvantage.customText}}</textarea></label>
              {{/if}}
            </div>
          </section>
        </div>
      </section>
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" disabled title="Granted Effects will be implemented in a later Alpha">
        <span>Granted Effects</span><i class="fa-solid fa-lock"></i>
      </button>
    </footer>
    {{/if}}

  </main>
</div>
