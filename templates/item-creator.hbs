          <label class="ic-identity-toggle"><input type="checkbox" data-override-toggle="icon" {{#if custom.icon}}checked{{/if}}><span><strong>Customize Icon</strong><small>Enable the icon button to select any indexed Item icon.</small></span></label>
          <dl class="ic-template-metadata"><div><dt>Tool Category</dt><dd>{{reviewSummary.baseWeapon}}</dd></div><div><dt>Base Tool</dt><dd>{{#if effective.baseItem}}{{effective.baseItem}}{{else}}Custom{{/if}}</dd></div><div><dt>Identifier</dt><dd>{{selectedWeapon.identifier}}</dd></div></dl>
        </section>
        <section class="ic-core-fields-panel">
          <header><span class="ic-kicker">Native Tool Structure</span><h3>Tool Fields</h3></header>
