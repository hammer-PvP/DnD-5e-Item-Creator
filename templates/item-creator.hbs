          <section class="ic-effect-card ic-span-two {{#if grantedEffects.grantMovementType}}enabled{{/if}} {{#if grantedEffectErrors.grantMovementType}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-effect-toggle="grantMovementType" {{#if grantedEffects.grantMovementType}}checked{{/if}}><span><strong>Grant Movement Type</strong><small>Grant a new speed such as Flying, Swimming, or Burrowing.</small></span></label><fieldset class="ic-effect-body" {{#unless grantedEffects.grantMovementType}}disabled{{/unless}}><div class="ic-effect-row-list">{{#each grantMovementTypeRows}}<div class="ic-effect-row movement-grant"><label><span>Movement</span><select data-effect-input="grantMovementType" data-effect-part="type" data-effect-row-id="{{id}}">{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Speed</span><input type="number" min="0" step="1" value="{{speed}}" data-effect-input="grantMovementType" data-effect-part="speed" data-effect-row-id="{{id}}" data-value-type="number"></label><label><span>Unit</span><select data-effect-input="grantMovementType" data-effect-part="units" data-effect-row-id="{{id}}">{{#each unitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label class="ic-mini-check"><input type="checkbox" data-effect-input="grantMovementType" data-effect-part="hover" data-effect-row-id="{{id}}" {{#if hover}}checked{{/if}}><span>Hover</span></label><button type="button" class="ic-row-remove" data-action="remove-effect-row" data-effect-key="grantMovementType" data-effect-row-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</div><button type="button" class="ic-add-effect-row" data-action="add-effect-row" data-effect-key="grantMovementType"><i class="fa-solid fa-plus"></i> Add Movement Type</button><label><span>Active While</span><select data-effect-input="grantMovementType" data-effect-part="availability">{{#each effectAvailability.grantMovementType}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset></section>
          <section class="ic-effect-card ic-span-two {{#if grantedEffects.grantedSense}}enabled{{/if}} {{#if grantedEffectErrors.grantedSense}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-effect-toggle="grantedSense" {{#if grantedEffects.grantedSense}}checked{{/if}}><span><strong>Granted Sense</strong><small>Grant or modify Darkvision, Blindsight, Tremorsense, or Truesight.</small></span></label><fieldset class="ic-effect-body" {{#unless grantedEffects.grantedSense}}disabled{{/unless}}><div class="ic-effect-row-list">{{#each grantedSenseRows}}<div class="ic-effect-row sense-row"><label><span>Sense</span><select data-effect-input="grantedSense" data-effect-part="sense" data-effect-row-id="{{id}}">{{#each senseOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Operation</span><select data-effect-input="grantedSense" data-effect-part="operation" data-effect-row-id="{{id}}">{{#each operationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Range</span><input type="number" min="0" step="1" value="{{range}}" data-effect-input="grantedSense" data-effect-part="range" data-effect-row-id="{{id}}" data-value-type="number"></label><label><span>Unit</span><select data-effect-input="grantedSense" data-effect-part="units" data-effect-row-id="{{id}}">{{#each unitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><button type="button" class="ic-row-remove" data-action="remove-effect-row" data-effect-key="grantedSense" data-effect-row-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</div><button type="button" class="ic-add-effect-row" data-action="add-effect-row" data-effect-key="grantedSense"><i class="fa-solid fa-plus"></i> Add Sense</button><label><span>Active While</span><select data-effect-input="grantedSense" data-effect-part="availability">{{#each effectAvailability.grantedSense}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset></section>
        </div>
      </section>

      <section class="ic-effect-group">
        <header><span class="ic-kicker">Spellcasting Statistics</span><h3>Global Spell Attack and Save DC</h3></header>
        <div class="ic-effect-grid">
          <section class="ic-effect-card {{#if grantedEffects.spellAttackBonus}}enabled{{/if}} {{#if grantedEffectErrors.spellAttackBonus}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-effect-toggle="spellAttackBonus" {{#if grantedEffects.spellAttackBonus}}checked{{/if}}><span><strong>Spell Attack Bonus</strong><small>Modify the Actor's global Spell Attack, not only granted spells.</small></span></label><fieldset class="ic-effect-body" {{#unless grantedEffects.spellAttackBonus}}disabled{{/unless}}><label><span>Modifier</span><input type="number" step="1" value="{{grantedEffectValues.spellAttackBonus.bonus}}" data-effect-input="spellAttackBonus" data-effect-part="bonus" data-value-type="number"></label><label><span>Active While</span><select data-effect-input="spellAttackBonus" data-effect-part="availability">{{#each effectAvailability.spellAttackBonus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset></section>
          <section class="ic-effect-card {{#if grantedEffects.spellSaveDcBonus}}enabled{{/if}} {{#if grantedEffectErrors.spellSaveDcBonus}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-effect-toggle="spellSaveDcBonus" {{#if grantedEffects.spellSaveDcBonus}}checked{{/if}}><span><strong>Spell Save DC Bonus</strong><small>Modify the Actor's global Spell Save DC.</small></span></label><fieldset class="ic-effect-body" {{#unless grantedEffects.spellSaveDcBonus}}disabled{{/unless}}><label><span>Modifier</span><input type="number" step="1" value="{{grantedEffectValues.spellSaveDcBonus.bonus}}" data-effect-input="spellSaveDcBonus" data-effect-part="bonus" data-value-type="number"></label><label><span>Active While</span><select data-effect-input="spellSaveDcBonus" data-effect-part="availability">{{#each effectAvailability.spellSaveDcBonus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset></section>
        </div>
      </section>

      {{#if customImportedEffectRows.length}}
      <section class="ic-effect-group ic-imported-custom-group">
        <header><span class="ic-kicker">Imported Custom Effects</span><h3>Untranslated or Independent Active Effect Data</h3><p>These changes are not folded into a normal Creator field, either because their key is unknown or because they must remain independent. They are rebuilt as new normalized Effects and can be kept, disabled, or removed.</p></header>
        <div class="ic-imported-custom-list">
          {{#each customImportedEffectRows}}
          <article class="ic-imported-custom-card {{#unless included}}excluded{{/unless}}">
            <header><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{summary}}</small></span><button type="button" data-action="remove-imported-effect" data-imported-id="{{id}}" aria-label="Remove imported effect"><i class="fa-solid fa-trash"></i></button></header>
            <div class="ic-imported-custom-controls">
              <label><input type="checkbox" data-imported-effect-input="included" data-imported-id="{{id}}" {{#if included}}checked{{/if}}><span>Include in final Item</span></label>
              <label><input type="checkbox" data-imported-effect-input="disabled" data-imported-id="{{id}}" {{#if disabled}}checked{{/if}}><span>Create Disabled</span></label>
            </div>
            <details><summary>Technical data</summary><pre>{{technical}}</pre></details>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if customImportedActivityRows.length}}
      <section class="ic-effect-group ic-imported-custom-group">
        <header><span class="ic-kicker">Imported Custom Activities</span><h3>Unrecognized Activity Data</h3><p>These Activities are rebuilt from the imported source. Disable an entry to keep its configuration in the Creator draft without placing it on the final Item.</p></header>
        <div class="ic-imported-custom-list">
          {{#each customImportedActivityRows}}
          <article class="ic-imported-custom-card {{#unless included}}excluded{{/unless}}">
            <header><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{summary}}</small></span><button type="button" data-action="remove-imported-activity" data-imported-id="{{id}}" aria-label="Remove imported activity"><i class="fa-solid fa-trash"></i></button></header>
            <div class="ic-imported-custom-controls">
              <label><input type="checkbox" data-imported-activity-input="included" data-imported-id="{{id}}" {{#if included}}checked{{/if}}><span>Include in final Item</span></label>
              <label><input type="checkbox" data-imported-activity-input="disabled" data-imported-id="{{id}}" {{#if disabled}}checked{{/if}}><span>Disable Activity</span></label>
            </div>
            <details><summary>Technical data</summary><pre>{{technical}}</pre></details>
          </article>
          {{/each}}
        </div>
      </section>
      {{/if}}
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless grantedEffectsComplete}}disabled{{/unless}}><span>Description</span><i class="fa-solid fa-chevron-right"></i></button>
    </footer>
    {{/if}}

    {{#if (eq step "description")}}
    <section class="ic-step-content ic-description-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Item Presentation</span>
          <h2>Description</h2>
          <p>The flavor description is inherited only from the selected Template. Item Creator appends generated Item Properties and the complete Level Progression below that flavor text.</p>
        </div>
      </header>

      <section class="ic-description-card">
        <header class="ic-description-source">
          <div>
            <span class="ic-kicker">Template Description</span>
            <h3>{{selectedWeapon.name}}</h3>
            <p>{{descriptionSource}}</p>
          </div>
          <span class="ic-support-badge native"><i class="fa-solid fa-filter"></i> Clean inherited preview</span>
        </header>

        <label class="ic-description-toggle">
          <input type="checkbox" data-description-toggle {{#if descriptionCustomized}}checked{{/if}}>
          <span>
            <strong>Customize Description</strong>
            <small>Enable the Foundry rich-text editor with the complete original Template description as the starting text. The physical base item never contributes separate description content.</small>
          </span>
        </label>

        {{#if descriptionCustomized}}
        <div class="ic-description-editor-shell" data-description-editor-host aria-label="Item description editor"></div>
        {{else}}
        <div class="editor editor-content ic-description-preview {{#unless hasTemplateDescription}}empty{{/unless}}">
          {{#if hasTemplateDescription}}
          {{{enrichedDescription}}}
          {{else}}
          <div class="ic-description-empty">
            <i class="fa-solid fa-align-left"></i>
            <strong>This Template has no description.</strong>
            <p>Enable Customize Description to write the final item text manually.</p>
          </div>
          {{/if}}
        </div>
        {{/if}}

        <aside class="ic-description-note">
          <i class="fa-solid fa-circle-info"></i>
          <p>Inherited preview mode conservatively removes recognized leading Template metadata. Customize mode loads the complete original Template HTML into Foundry’s native editor. Generated Item Properties and Level Progression are appended below the flavor text when the Item is built and are regenerated without duplication on later edits.</p>
        </aside>
      </section>
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless descriptionComplete}}disabled{{/unless}}><span>Review</span><i class="fa-solid fa-chevron-right"></i></button>
    </footer>
    {{/if}}

    {{#if (eq step "review")}}
    <section class="ic-step-content ic-review-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">Final Validation</span>
          <h2>Review Item</h2>
          <p>{{#if editMode}}Review the native-style chat presentation and compact inventory appearance before updating the original World Item or saving the current configuration as a new copy.{{else}}Review the native-style chat presentation and the compact inventory appearance before creating the Item in the world Items Directory.{{/if}}</p>
        </div>
      </header>

      {{#if reviewError}}
      <aside class="ic-review-error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div><strong>Preview could not be built</strong><p>{{reviewError}}</p></div>
      </aside>
      {{else}}
      <div class="ic-review-preview-grid">
        <section class="ic-review-panel ic-chat-preview-panel">
          <header><span class="ic-kicker">Chat Presentation</span><h3>Native Item Card</h3></header>
          <div class="ic-native-chat-preview">{{{reviewChatCard}}}</div>
        </section>

        <section class="ic-review-panel ic-inventory-preview-panel">
          <header><span class="ic-kicker">Inventory Presentation</span><h3>Item Card</h3></header>
          {{#if reviewInventory}}
          <article class="ic-inventory-card">
            <img src="{{reviewInventory.img}}" alt="{{reviewInventory.name}}">
            <div class="ic-inventory-main">
              <div class="ic-inventory-title"><strong>{{reviewInventory.name}}</strong>{{#if reviewInventory.magical}}<i class="fa-solid fa-sparkles" title="Magical"></i>{{/if}}</div>
              <p>{{reviewInventory.type}} · {{reviewInventory.rarity}}</p>
              <dl>
                {{#if isWeapon}}<div><dt>Damage</dt><dd>{{reviewInventory.damage}}</dd></div>{{else if isEquipment}}<div><dt>Equipment Type</dt><dd>{{reviewInventory.equipmentType}}</dd></div>{{#if reviewInventory.armor}}<div><dt>Armor Class</dt><dd>{{reviewInventory.armor}}</dd></div>{{/if}}{{else if isTool}}<div><dt>Tool Category</dt><dd>{{reviewInventory.toolType}}</dd></div><div><dt>Tool Check Bonus</dt><dd>{{reviewInventory.toolBonus}}</dd></div>{{/if}}
                <div><dt>Attunement</dt><dd>{{reviewInventory.attunement}}</dd></div>
                <div><dt>Price</dt><dd>{{reviewInventory.price}} <small>({{reviewInventory.priceMode}})</small></dd></div>
                <div><dt>Quantity</dt><dd>{{reviewInventory.quantity}}</dd></div>
                <div><dt>Effects</dt><dd>{{reviewInventory.effects}}</dd></div>
              </dl>
              {{#if reviewInventory.properties.length}}
              <div class="ic-inventory-tags">{{#each reviewInventory.properties}}<span>{{this}}</span>{{/each}}</div>
              {{/if}}
            </div>
          </article>

          <div class="ic-review-activities">
            <h4>Activities</h4>
            {{#if reviewInventory.activities.length}}
              {{#each reviewInventory.activities}}
              <div class="ic-review-activity"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{type}}</small></span></div>
              {{/each}}
            {{else}}
              <p>No Activities are configured.</p>
            {{/if}}
          </div>
          {{/if}}
        </section>
      </div>

      <section class="ic-review-summary">
        <header><span class="ic-kicker">Configuration Summary</span><h3>Final Draft</h3></header>
        <dl>
          <div><dt>{{#if isWeapon}}Template{{else}}Base Item{{/if}}</dt><dd>{{reviewSummary.template}}</dd></div>
          <div><dt>{{#if isWeapon}}Base Weapon{{else if isEquipment}}Equipment Form{{else}}Tool Category{{/if}}</dt><dd>{{reviewSummary.baseWeapon}}</dd></div>
          <div><dt>Final Name</dt><dd>{{reviewSummary.name}}</dd></div>
          <div><dt>Base Overrides</dt><dd>{{reviewSummary.baseOverrides}}</dd></div>
          <div><dt>Enhancements</dt><dd>{{reviewSummary.enhancements}}</dd></div>
          <div><dt>Granted Spells</dt><dd>{{reviewSummary.grantedSpells}}</dd></div>
          <div><dt>Granted Effects</dt><dd>{{reviewSummary.grantedEffects}}</dd></div>
          <div><dt>Converted Base Properties</dt><dd>{{reviewSummary.convertedProperties}}</dd></div>
          <div><dt>Custom Imported Data</dt><dd>{{reviewSummary.importedCustom}}</dd></div>
          <div><dt>Level Progressions</dt><dd>{{reviewSummary.progressions}}</dd></div>
          <div><dt>Description</dt><dd>{{reviewSummary.description}}</dd></div>
        </dl>

        {{#if convertedImportedSummary.length}}
        <section class="ic-review-import-breakdown">
          <header><strong>Imported and Converted Properties</strong><small>Native mechanics translated into editable Item Creator fields.</small></header>
          <ul>{{#each convertedImportedSummary}}<li>{{this}}</li>{{/each}}</ul>
        </section>
        {{/if}}

        {{#if reviewImportedEffects.length}}
        <section class="ic-review-import-breakdown">
          <header><strong>Custom Imported Effects</strong><small>Unrecognized Effect data rebuilt as normalized custom Effects.</small></header>
          <ul>{{#each reviewImportedEffects}}<li><strong>{{name}}</strong> — {{summary}}{{#if disabled}} (disabled){{/if}}</li>{{/each}}</ul>
        </section>
        {{/if}}

        {{#if reviewImportedActivities.length}}
        <section class="ic-review-import-breakdown">
          <header><strong>Custom Imported Activities</strong><small>Unrecognized Activities rebuilt from their technical source.</small></header>
          <ul>{{#each reviewImportedActivities}}<li><strong>{{name}}</strong> — {{summary}}{{#if disabled}} (excluded from final Item){{/if}}</li>{{/each}}</ul>
        </section>
        {{/if}}

        <section class="ic-review-import-breakdown">
          <header><strong>New Creator Properties</strong><small>Enhancements, Granted Effects, and Granted Spells configured in this draft.</small></header>
          <p>{{reviewSummary.enhancements}} Enhancement(s), {{reviewSummary.grantedEffects}} Granted Effect(s), and {{reviewSummary.grantedSpells}} Granted Spell(s).</p>
        </section>

        <aside><i class="fa-solid fa-circle-info"></i><p>{{#if editMode}}Update Item modifies the selected World Item in place. Save as Copy creates a separate World Item and leaves the original unchanged. Existing copies already placed on Actors are not automatically updated.{{else}}Save Item creates a new world Item. Return to any previous step to revise the name or configuration; existing draft selections are preserved.{{/if}}</p></aside>
      </section>
      {{/if}}
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      {{#if editMode}}
      <div class="ic-edit-save-actions">
        <button type="button" class="ic-save-copy" data-action="save-copy" {{#unless reviewReady}}disabled{{/unless}}>
          <i class="fa-solid fa-copy"></i><span>{{#if savingItem}}Working…{{else}}Save as Copy{{/if}}</span>
        </button>
        <button type="button" class="ic-primary-continue ic-save-item" data-action="update-item" {{#unless reviewReady}}disabled{{/unless}}>
          <i class="fa-solid fa-floppy-disk"></i><span>{{#if savingItem}}Updating…{{else}}Update Item{{/if}}</span>
        </button>
      </div>
      {{else}}
      <button type="button" class="ic-primary-continue ic-save-item" data-action="save-item" {{#unless reviewReady}}disabled{{/unless}}>
        <i class="fa-solid fa-floppy-disk"></i><span>{{#if savingItem}}Creating…{{else}}Save Item{{/if}}</span>
      </button>
      {{/if}}
    </footer>
    {{/if}}

  </main>
</div>
