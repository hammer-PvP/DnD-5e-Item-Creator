            <section class="ic-override-card {{#if custom.price}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-override-toggle="price" {{#if custom.price}}checked{{/if}}><span><strong>Customize Price</strong><small>Market value and currency.</small></span></label><div class="ic-inline-fields"><label class="ic-grow"><span>Value</span><input type="number" min="0" step="0.01" value="{{effective.price.value}}" data-override-input="price" data-override-part="value" data-value-type="number" {{#unless custom.price}}disabled{{/unless}}></label><label><span>Currency</span><select data-override-input="price" data-override-part="denomination" {{#unless custom.price}}disabled{{/unless}}>{{#each currencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div></section>

