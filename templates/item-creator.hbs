            <div class="ic-enhancement-fields {{#if (eq enhancementValues.criticalThreshold.mode "custom")}}two-columns{{/if}}">
              <label><span>Critical Hit On</span><select data-enhancement-input="criticalThreshold" data-enhancement-part="mode" {{#unless enhancement.criticalThreshold}}disabled{{/unless}}>{{#each criticalThresholdOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{#if (eq enhancementValues.criticalThreshold.mode "custom")}}<label><span>Custom Threshold</span><input type="number" min="1" max="20" step="1" value="{{enhancementValues.criticalThreshold.custom}}" data-enhancement-input="criticalThreshold" data-enhancement-part="custom" data-value-type="number" {{#unless enhancement.criticalThreshold}}disabled{{/unless}}></label>{{/if}}
            </div>
          </section>

          <section class="ic-enhancement-card {{#if enhancement.extraCriticalDamage}}enabled{{/if}} {{#if enhancementErrors.extraCriticalDamage}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="extraCriticalDamage" {{#if enhancement.extraCriticalDamage}}checked{{/if}}>
              <span><strong>Extra Critical Damage</strong><small>Add a separate typed damage die part only when this weapon scores a Critical Hit.</small></span>
            </label>
            <div class="ic-enhancement-fields critical-damage-fields">
              <label><span>Dice</span><input type="number" min="1" max="20" step="1" value="{{enhancementValues.extraCriticalDamage.number}}" data-enhancement-input="extraCriticalDamage" data-enhancement-part="number" data-value-type="number" {{#unless enhancement.extraCriticalDamage}}disabled{{/unless}}></label>
              <label><span>Die</span><select data-enhancement-input="extraCriticalDamage" data-enhancement-part="denomination" data-value-type="number" {{#unless enhancement.extraCriticalDamage}}disabled{{/unless}}>{{#each criticalDamageDiceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label><span>Damage Type</span><select data-enhancement-input="extraCriticalDamage" data-enhancement-part="damageType" {{#unless enhancement.extraCriticalDamage}}disabled{{/unless}}>{{#each criticalDamageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </div>
          </section>
        </div>
      </section>

      {{else if isEquipment}}
      <header class="ic-section-header"><div><span class="ic-kicker">Equipment Creation</span><h2>Enhancements</h2><p>Configure only structural properties of the Equipment document here. Actor-facing powers belong in Granted Effects.</p></div></header>
      <aside class="ic-alpha-note ic-enhancement-note"><i class="fa-solid fa-layer-group"></i><div><strong>Filtered for Equipment</strong><p>Weapon-only attack, damage, Mastery, and weapon critical fields are hidden. Armor-specific options appear only for Armor and Shield forms.</p></div></aside>
      <section class="ic-enhancement-group"><header><span class="ic-kicker">Magical Configuration</span><h3>Magical Nature and Armor Data</h3></header><div class="ic-enhancement-grid">
        <section class="ic-enhancement-card {{#if enhancement.magicalItem}}enabled{{/if}} {{#if enhancementErrors.magicalItem}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="magicalItem" {{#if enhancement.magicalItem}}checked{{/if}}><span><strong>Magical Equipment</strong><small>Set rarity and attunement for any armor, robe, ring, amulet, focus, or accessory.</small></span></label>{{#if magicalAutoFromGrantedSpellcasting}}<small class="ic-mechanical-note"><i class="fa-solid fa-wand-magic-sparkles"></i> Enabled automatically by Granted Spellcasting. No enchantment bonus or attunement is added.</small>{{/if}}<div class="ic-enhancement-fields two-columns"><label><span>Rarity</span><select data-enhancement-input="magicalItem" data-enhancement-part="rarity" {{#unless enhancement.magicalItem}}disabled{{/unless}}>{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Attunement</span><select data-enhancement-input="magicalItem" data-enhancement-part="attunement" {{#unless enhancement.magicalItem}}disabled{{/unless}}>{{#each attunementOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div></section>
        {{#if hasArmorFields}}
        <section class="ic-enhancement-card {{#if enhancement.armorEnhancement}}enabled{{/if}} {{#if enhancementErrors.armorEnhancement}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="armorEnhancement" {{#if enhancement.armorEnhancement}}checked{{/if}}><span><strong>Armor Enhancement</strong><small>Apply the native +1, +2, or +3 magical armor bonus.</small></span></label><label class="ic-enhancement-field"><span>Enhancement Bonus</span><select data-enhancement-input="armorEnhancement" data-enhancement-part="bonus" data-value-type="number" {{#unless enhancement.armorEnhancement}}disabled{{/unless}}>{{#each enhancementBonusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></section>
        <section class="ic-enhancement-card {{#if enhancement.baseArmorClass}}enabled{{/if}} {{#if enhancementErrors.baseArmorClass}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="baseArmorClass" {{#if enhancement.baseArmorClass}}checked{{/if}}><span><strong>Base Armor Class Override</strong><small>Replace the native base AC value.</small></span></label><label class="ic-enhancement-field"><span>Base AC</span><input type="number" min="0" max="40" step="1" value="{{enhancementValues.baseArmorClass.value}}" data-enhancement-input="baseArmorClass" data-enhancement-part="value" data-value-type="number" {{#unless enhancement.baseArmorClass}}disabled{{/unless}}></label></section>
        <section class="ic-enhancement-card {{#if enhancement.removeStrengthRequirement}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="removeStrengthRequirement" {{#if enhancement.removeStrengthRequirement}}checked{{/if}}><span><strong>Remove Strength Requirement</strong><small>Set the native Strength requirement to none.</small></span></label></section>
        <section class="ic-enhancement-card {{#if enhancement.removeStealthDisadvantage}}enabled{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="removeStealthDisadvantage" {{#if enhancement.removeStealthDisadvantage}}checked{{/if}}><span><strong>Remove Stealth Disadvantage</strong><small>Remove the native Stealth Disadvantage property.</small></span></label></section>
        {{/if}}
      </div></section>
      {{else if isTool}}
      <header class="ic-section-header"><div><span class="ic-kicker">Tool Creation</span><h2>Enhancements</h2><p>Configure only structural properties of the Tool document here. Tool Check Bonus belongs in Base Item; Actor-facing powers belong in Granted Effects.</p></div></header>
      <aside class="ic-alpha-note ic-enhancement-note"><i class="fa-solid fa-layer-group"></i><div><strong>Filtered for Tools</strong><p>Weapon damage, attack Activities, Mastery, Armor Class structure, and enchantment bonuses are unavailable because this document remains a Tool.</p></div></aside>
      <section class="ic-enhancement-group"><header><span class="ic-kicker">Magical Configuration</span><h3>Magical Nature</h3></header><div class="ic-enhancement-grid">
        <section class="ic-enhancement-card ic-span-two {{#if enhancement.magicalTool}}enabled{{/if}} {{#if enhancementErrors.magicalTool}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-enhancement-toggle="magicalTool" {{#if enhancement.magicalTool}}checked{{/if}}><span><strong>Magical Tool</strong><small>Set rarity and optional attunement without adding any weapon or armor enchantment.</small></span></label>{{#if magicalAutoFromGrantedSpellcasting}}<small class="ic-mechanical-note"><i class="fa-solid fa-wand-magic-sparkles"></i> Enabled automatically by Granted Spellcasting. No enchantment bonus or attunement is added.</small>{{/if}}<div class="ic-enhancement-fields two-columns"><label><span>Rarity</span><select data-enhancement-input="magicalTool" data-enhancement-part="rarity" {{#unless enhancement.magicalTool}}disabled{{/unless}}>{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Attunement</span><select data-enhancement-input="magicalTool" data-enhancement-part="attunement" {{#unless enhancement.magicalTool}}disabled{{/unless}}>{{#each attunementOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div></section>
      </div></section>
      {{/if}}

      <section class="ic-enhancement-group ic-spellcasting-group">
        <header>
          <span class="ic-kicker">Granted Magic</span>
          <h3>Granted Spellcasting</h3>
        </header>
        <section class="ic-enhancement-card ic-span-two ic-granted-spellcasting-card {{#if enhancement.grantedSpellcasting}}enabled{{/if}} {{#if enhancementErrors.grantedSpellcasting}}invalid{{/if}}">
          <label class="ic-override-heading">
            <input type="checkbox" data-enhancement-toggle="grantedSpellcasting" {{#if enhancement.grantedSpellcasting}}checked{{/if}}>
            <span><strong>Granted Spellcasting</strong><small>Grant one or more existing Spells through this item. Each Spell has independent uses, recovery, slot consumption, eligibility, cast level, spellcasting calculation, spellbook visibility, and availability.</small></span>
          </label>

          <div class="ic-spell-drop-zone {{#unless enhancement.grantedSpellcasting}}disabled{{/unless}}" data-spell-drop-zone>
            <i class="fa-solid fa-wand-sparkles"></i>
            <div>
              <strong>Drop a Spell here</strong>
              <small>Drag a Spell Item from a compendium or directory, or use the native D&amp;D5e Spell Browser.</small>
            </div>
            <button type="button" data-action="browse-spells" {{#unless enhancement.grantedSpellcasting}}disabled{{/unless}}>
              <i class="fa-solid fa-books"></i> Browse Spells
            </button>
          </div>

          {{#if enhancement.grantedSpellcasting}}
            {{#if grantedSpellRows.length}}
            <div class="ic-granted-spell-list">
              {{#each grantedSpellRows}}
              <article class="ic-granted-spell {{#if invalid}}invalid{{/if}}" data-spell-id="{{id}}">
                <header class="ic-granted-spell-header">
                  <img src="{{img}}" alt="{{name}}">
                  <div>
                    <strong>{{name}}</strong>
                    <span>{{spellLevelLabel}} · {{schoolLabel}}</span>
                    <small>{{source}}</small>
                  </div>
                  <button type="button" class="ic-icon-button danger" data-action="remove-granted-spell" data-spell-id="{{id}}" aria-label="Remove {{name}}" title="Remove Spell">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </header>

                <div class="ic-spell-config-grid">
                  <section class="ic-spell-config-panel">
                    <h4>Uses and Recovery</h4>
                    <label><span>Use Limit</span><select data-granted-spell-input="useLimit" data-spell-id="{{id}}">{{#each useLimitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if isLimited}}
                    <div class="ic-spell-inline-fields">
                      <label><span>Maximum Uses</span><input type="number" min="1" max="99" step="1" value="{{maxUses}}" data-granted-spell-input="maxUses" data-spell-id="{{id}}" data-value-type="number"></label>
                      <label><span>Recovery</span><select data-granted-spell-input="recovery" data-spell-id="{{id}}">{{#each recoveryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    </div>
                    {{else}}
                    <small class="ic-field-note">Unlimited means the item has no charge limit. Spell-slot consumption can still limit actual use.</small>
                    {{/if}}
                    <label class="ic-checkbox-line {{#if isCantrip}}disabled{{/if}}">
                      <input type="checkbox" data-granted-spell-input="consumeSlot" data-spell-id="{{id}}" {{#if consumeSlot}}checked{{/if}} {{#if isCantrip}}disabled{{/if}}>
                      <span><strong>Consume a Spell Slot</strong><small>{{#if isCantrip}}Cantrips never consume spell slots.{{else}}Require and consume a compatible slot for every cast.{{/if}}</small></span>
                    </label>
                  </section>

                  <section class="ic-spell-config-panel">
                    <h4>Eligibility and Cast Level</h4>
                    <label><span>Casting Eligibility</span><select data-granted-spell-input="eligibility" data-spell-id="{{id}}" {{#if consumeSlot}}disabled{{/if}}>{{#each eligibilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if consumeSlot}}<small class="ic-field-note">Spell-slot consumption automatically requires a compatible spell slot.</small>{{/if}}
                    <label><span>Cast Level</span><select data-granted-spell-input="castLevelMode" data-spell-id="{{id}}">{{#each castLevelModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if (eq castLevelMode "fixed")}}
                    <label><span>Fixed Cast Level</span><select data-granted-spell-input="fixedCastLevel" data-spell-id="{{id}}" data-value-type="number">{{#each fixedCastLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{/if}}
                  </section>

                  <section class="ic-spell-config-panel ic-spellcasting-calculation">
                    <h4>Spellcasting Calculation</h4>
                    <label><span>Spellcasting</span><select data-granted-spell-input="spellcastingMode" data-spell-id="{{id}}">{{#each spellcastingModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if usesFixedSpellcasting}}
                      {{#if hasAttack}}<label><span>Fixed Spell Attack Bonus</span><input type="number" min="-20" max="40" step="1" value="{{fixedAttackBonus}}" data-granted-spell-input="fixedAttackBonus" data-spell-id="{{id}}" data-value-type="number"></label>{{/if}}
                      {{#if hasSave}}<label><span>Fixed Spell Save DC</span><input type="number" min="1" max="40" step="1" value="{{fixedSaveDc}}" data-granted-spell-input="fixedSaveDc" data-spell-id="{{id}}" data-value-type="number"></label>{{/if}}
                      {{#unless hasAttack}}{{#unless hasSave}}<small class="ic-field-note">This Spell has no detected Spell Attack or Saving Throw, so fixed attack and DC values are not required.</small>{{/unless}}{{/unless}}
                    {{else}}
                    <small class="ic-field-note">Actor Default, Highest Spellcasting, or Intelligence/Wisdom/Charisma + Proficiency can support both spellcasters and non-spellcasters.</small>
                    {{/if}}
                  </section>

                  <section class="ic-spell-config-panel">
                    <h4>Availability</h4>
                    <label><span>Available While</span><select data-granted-spell-input="availability" data-spell-id="{{id}}">{{#each availabilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="ic-checkbox-line">
                      <input type="checkbox" data-granted-spell-input="showInSpellbook" data-spell-id="{{id}}" {{#if showInSpellbook}}checked{{/if}}>
                      <span><strong>Show Granted Spell in Spellbook</strong><small>Expose the linked Spell in the Actor spellbook while the item grants it.</small></span>
                    </label>
                  </section>
                </div>
              </article>
              {{/each}}
            </div>
            {{else}}
            <div class="ic-spell-empty-state">
              <i class="fa-solid fa-book-open"></i>
              <strong>No Spells added</strong>
              <p>Drop a Spell above or use Browse Spells. An enabled Granted Spellcasting card requires at least one valid Spell.</p>
            </div>
            {{/if}}
          {{/if}}
        </section>
      </section>

      <section class="ic-enhancement-group">
        <header>
          <span class="ic-kicker">Advanced Combat Behavior</span>
          <h3>Runtime and Conditional Rules</h3>
        </header>
        <div class="ic-enhancement-grid">
          <section class="ic-enhancement-card ic-span-two {{#if enhancement.ignoreResistance}}enabled{{/if}} {{#if enhancementErrors.ignoreResistance}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="ignoreResistance" {{#if enhancement.ignoreResistance}}checked{{/if}}>
              <span><strong>Ignore Damage Resistance</strong><small>Damage of the selected types while this item applies ignores resistance, but not immunity.</small></span>
            </label>
            <span class="ic-support-badge runtime"><i class="fa-solid fa-microchip"></i> Item Creator Runtime</span>
            <div class="ic-resistance-grid">
              {{#each resistanceDamageTypes}}
              <label class="ic-property-option {{#if selected}}selected{{/if}}">
                <input type="checkbox" data-resistance-type="{{value}}" {{#if selected}}checked{{/if}} {{#unless ../enhancement.ignoreResistance}}disabled{{/unless}}>
                <span>{{label}}</span>
              </label>
              {{/each}}
            </div>
          </section>

          <section class="ic-enhancement-card ic-span-two {{#if enhancement.conditionalAdvantage}}enabled{{/if}} {{#if enhancementErrors.conditionalAdvantage}}invalid{{/if}}">
            <label class="ic-override-heading">
              <input type="checkbox" data-enhancement-toggle="conditionalAdvantage" {{#if enhancement.conditionalAdvantage}}checked{{/if}}>
              <span><strong>Conditional Advantage</strong><small>Grant Advantage on supported Attack Rolls while this item applies, or record a custom descriptive rule.</small></span>
            </label>
            <span class="ic-support-badge {{#if conditionalIsSupported}}runtime{{else}}description{{/if}}"><i class="fa-solid {{#if conditionalIsSupported}}fa-microchip{{else}}fa-align-left{{/if}}"></i> {{conditionalSupportLabel}}</span>
            <div class="ic-enhancement-fields conditional-fields">
              <label><span>Condition Type</span><select data-enhancement-input="conditionalAdvantage" data-enhancement-part="mode" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{#each conditionalModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <label><span>Applies To</span><select data-enhancement-input="conditionalAdvantage" data-enhancement-part="appliesTo" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{#each conditionalAppliesToOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{#if conditionalIsSupported}}
              <label class="ic-span-two"><span>Supported Condition</span><select data-enhancement-input="conditionalAdvantage" data-enhancement-part="supportedCondition" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{#each supportedConditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{else}}
              <label class="ic-span-two"><span>Custom Rule Text</span><textarea rows="3" maxlength="500" data-enhancement-input="conditionalAdvantage" data-enhancement-part="customText" {{#unless enhancement.conditionalAdvantage}}disabled{{/unless}}>{{enhancementValues.conditionalAdvantage.customText}}</textarea></label>
              {{/if}}
            </div>
          </section>
        </div>
      </section>
    </section>

    <footer class="ic-navigation">
      <button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> Back</button>
      <button type="button" class="ic-primary-continue" data-action="continue" {{#unless enhancementsComplete}}disabled{{/unless}}>
        <span>Granted Effects</span><i class="fa-solid fa-chevron-right"></i>
      </button>
    </footer>
    {{/if}}

    {{#if (eq step "grantedEffects")}}
    <section class="ic-step-content ic-granted-effects-step">
      <header class="ic-section-header">
        <div>
          <span class="ic-kicker">{{itemTypeLabel}} Creation</span>
          <h2>Granted Effects</h2>
          <p>Enable only the passive effects this item grants to its bearer. The complete Actor-facing library is available to Weapons, Equipment, and Tools.</p>
        </div>
      </header>

      <aside class="ic-alpha-note ic-effect-note">
        <i class="fa-solid fa-shield-heart"></i>
        <div>
          <strong>Availability-aware effects</strong>
          <p>Each effect can apply while owned, equipped, or equipped and attuned. Unlock on Level adds the Actor's total character level as a second requirement, and progression tiers replace earlier values instead of stacking them.</p>
        </div>
      </aside>

      <section class="ic-effect-group">
        <header><span class="ic-kicker">Defensive Effects</span><h3>Armor, Saves, Resistances, and Immunities</h3></header>
        <div class="ic-effect-grid">
          <section class="ic-effect-card {{#if grantedEffects.armorClassBonus}}enabled{{/if}} {{#if grantedEffectErrors.armorClassBonus}}invalid{{/if}}">
            <label class="ic-override-heading"><input type="checkbox" data-effect-toggle="armorClassBonus" {{#if grantedEffects.armorClassBonus}}checked{{/if}}><span><strong>Armor Class Bonus</strong><small>Add any numeric bonus or penalty to Armor Class.</small></span></label>
            <fieldset class="ic-effect-body" {{#unless grantedEffects.armorClassBonus}}disabled{{/unless}}>
              <label><span>AC Modifier</span><input type="number" step="1" value="{{grantedEffectValues.armorClassBonus.bonus}}" data-effect-input="armorClassBonus" data-effect-part="bonus" data-value-type="number"></label>
              <label><span>Active While</span><select data-effect-input="armorClassBonus" data-effect-part="availability">{{#each effectAvailability.armorClassBonus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </fieldset>
          </section>

          <section class="ic-effect-card {{#if grantedEffects.weaponAttackBonus}}enabled{{/if}} {{#if grantedEffectErrors.weaponAttackBonus}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-effect-toggle="weaponAttackBonus" {{#if grantedEffects.weaponAttackBonus}}checked{{/if}}><span><strong>Weapon Attack Roll Bonus</strong><small>Add a global bonus to melee and ranged weapon attack rolls made by the Actor.</small></span></label><fieldset class="ic-effect-body" {{#unless grantedEffects.weaponAttackBonus}}disabled{{/unless}}><label><span>Modifier</span><input type="number" step="1" value="{{grantedEffectValues.weaponAttackBonus.bonus}}" data-effect-input="weaponAttackBonus" data-effect-part="bonus" data-value-type="number"></label><label><span>Active While</span><select data-effect-input="weaponAttackBonus" data-effect-part="availability">{{#each effectAvailability.weaponAttackBonus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset></section>
          <section class="ic-effect-card {{#if grantedEffects.weaponDamageBonus}}enabled{{/if}} {{#if grantedEffectErrors.weaponDamageBonus}}invalid{{/if}}"><label class="ic-override-heading"><input type="checkbox" data-effect-toggle="weaponDamageBonus" {{#if grantedEffects.weaponDamageBonus}}checked{{/if}}><span><strong>Weapon Damage Roll Bonus</strong><small>Add a global bonus to melee and ranged weapon damage rolls made by the Actor.</small></span></label><fieldset class="ic-effect-body" {{#unless grantedEffects.weaponDamageBonus}}disabled{{/unless}}><label><span>Modifier</span><input type="number" step="1" value="{{grantedEffectValues.weaponDamageBonus.bonus}}" data-effect-input="weaponDamageBonus" data-effect-part="bonus" data-value-type="number"></label><label><span>Active While</span><select data-effect-input="weaponDamageBonus" data-effect-part="availability">{{#each effectAvailability.weaponDamageBonus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset></section>

          <section class="ic-effect-card {{#if grantedEffects.criticalThreshold}}enabled{{/if}} {{#if grantedEffectErrors.criticalThreshold}}invalid{{/if}}">
            <label class="ic-override-heading"><input type="checkbox" data-effect-toggle="criticalThreshold" {{#if grantedEffects.criticalThreshold}}checked{{/if}}><span><strong>Actor Critical Threshold</strong><small>Changes the Actor's critical threshold while this Item is active, according to Applies To.</small></span></label>
            <fieldset class="ic-effect-body" {{#unless grantedEffects.criticalThreshold}}disabled{{/unless}}><label><span>Critical Hit On</span><select data-effect-input="criticalThreshold" data-effect-part="threshold" data-value-type="number">{{#each criticalThresholdEffectOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Applies To</span><select data-effect-input="criticalThreshold" data-effect-part="scope">{{#each criticalThresholdScopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Active While</span><select data-effect-input="criticalThreshold" data-effect-part="availability">{{#each effectAvailability.criticalThreshold}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></fieldset>
          </section>

          <section class="ic-effect-card ic-span-two {{#if grantedEffects.savingThrowBonus}}enabled{{/if}} {{#if grantedEffectErrors.savingThrowBonus}}invalid{{/if}}">
            <label class="ic-override-heading"><input type="checkbox" data-effect-toggle="savingThrowBonus" {{#if grantedEffects.savingThrowBonus}}checked{{/if}}><span><strong>Saving Throw Bonus</strong><small>Apply a manual modifier to one Saving Throw or all six Saving Throws at once.</small></span></label>
            <fieldset class="ic-effect-body" {{#unless grantedEffects.savingThrowBonus}}disabled{{/unless}}>
              <div class="ic-effect-row-list">
                {{#each savingThrowBonusRows}}
                <div class="ic-effect-row three-fields"><label><span>Applies To</span><select data-effect-input="savingThrowBonus" data-effect-part="target" data-effect-row-id="{{id}}">{{#each targetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>Modifier</span><input type="number" step="1" value="{{bonus}}" data-effect-input="savingThrowBonus" data-effect-part="bonus" data-effect-row-id="{{id}}" data-value-type="number"></label><button type="button" class="ic-row-remove" data-action="remove-effect-row" data-effect-key="savingThrowBonus" data-effect-row-id="{{id}}" title="Remove"><i class="fa-solid fa-trash"></i></button></div>
                {{/each}}
              </div>
              <button type="button" class="ic-add-effect-row" data-action="add-effect-row" data-effect-key="savingThrowBonus"><i class="fa-solid fa-plus"></i> Add Saving Throw Modifier</button>
              <label><span>Active While</span><select data-effect-input="savingThrowBonus" data-effect-part="availability">{{#each effectAvailability.savingThrowBonus}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </fieldset>
          </section>

          <section class="ic-effect-card ic-span-two {{#if grantedEffects.savingThrowAdvantage}}enabled{{/if}} {{#if grantedEffectErrors.savingThrowAdvantage}}invalid{{/if}}">
