<div class="ic-spell-factory-shell">
  <header class="ic-spell-factory-header">
    <div>
      <span class="ic-kicker">Native D&D5e Spell Authoring</span>
      <h1>Spell Factory</h1>
      <p>v{{version}} · {{stage}}</p>
    </div>
    <button type="button" data-action="open-published-spells" {{#if hasDraft}}disabled{{/if}}><i class="fa-solid fa-book-atlas"></i> Published Spells</button>
  </header>

  {{#unless hasDraft}}
  <main class="ic-spell-factory-home">
    <section class="ic-spell-factory-intro">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <div>
        <h2>Create a real D&D5e Spell</h2>
        <p>Start blank or clone any Spell as a blueprint. Spell Factory creates an independent working draft in an Item Creator internal compendium; the original source is never modified and only reviewed output enters Published Spells.</p>
      </div>
    </section>

    <div class="ic-spell-factory-start-grid">
      <button type="button" class="ic-spell-start-card" data-action="new-blank-spell" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-file-circle-plus"></i>
        <span><strong>Blank Spell</strong><small>Start from a native Spell5e skeleton.</small></span>
      </button>
      <button type="button" class="ic-spell-start-card" data-action="browse-spell-blueprint" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-books"></i>
        <span><strong>Use Spell as Blueprint</strong><small>Clone Fireball, Find Steed, Summon Beast, or any other Spell without touching the source.</small></span>
      </button>
    </div>

    <section class="ic-spell-blueprint-drop {{#if busy}}busy{{/if}}" data-spell-blueprint-drop>
      <i class="fa-solid fa-file-arrow-down"></i>
      <div><strong>Drop a Spell here</strong><small>Compendium, Actor Spellbook, or World Item.</small></div>
    </section>

    {{#if hasSavedDrafts}}
    <section class="ic-spell-drafts">
      <header><div><span class="ic-kicker">Work in Progress</span><h2>Saved Drafts</h2></div><span>{{drafts.length}}</span></header>
      <div class="ic-spell-draft-list">
        {{#each drafts}}
        <article>
          <img src="{{img}}" alt="">
          <div><strong>{{name}}</strong><small>{{#if editing}}Editing Published Spell{{else}}Blueprint: {{sourceName}}{{/if}}</small></div>
          <button type="button" data-action="resume-spell-draft" data-draft-id="{{id}}"><i class="fa-solid fa-arrow-right"></i> Resume</button>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </main>
  {{else}}
  <main class="ic-spell-factory-editor">
    <section class="ic-spell-draft-identity">
      <img src="{{draft.img}}" alt="">
      <div>
        <span class="ic-kicker">{{#if editingPublished}}Protected Edit Draft{{else}}Spell Factory Draft{{/if}}</span>
        <h2>{{draft.name}}</h2>
        <p>{{draft.levelLabel}} · {{draft.schoolLabel}} · {{draft.identifier}}</p>
        {{#if sourceUuid}}<small>Blueprint: {{sourceName}} · source remains untouched</small>{{else}}<small>Blank native Spell draft</small>{{/if}}
      </div>
      <button type="button" class="ic-spell-native-edit" data-action="edit-native-spell" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <span><strong>Edit Native Spell</strong><small>All D&D5e fields, Activities, Effects, scaling, targeting, components, and summon profiles remain native.</small></span>
      </button>
    </section>

    <div class="ic-spell-factory-columns">
      <section class="ic-spell-summary-panel">
        <header><span class="ic-kicker">Native Spell5e</span><h3>Current Spell Data</h3></header>
        <dl class="ic-spell-summary-grid">
          <div><dt>Level</dt><dd>{{draft.levelLabel}}</dd></div>
          <div><dt>School</dt><dd>{{draft.schoolLabel}}</dd></div>
          <div><dt>Casting</dt><dd>{{draft.activationLabel}}</dd></div>
          <div><dt>Range</dt><dd>{{draft.rangeLabel}}</dd></div>
          <div><dt>Duration</dt><dd>{{draft.durationLabel}}</dd></div>
          <div><dt>Concentration</dt><dd>{{#if draft.concentration}}Yes{{else}}No{{/if}}</dd></div>
          <div><dt>Activities</dt><dd>{{draft.activityCount}}</dd></div>
          <div><dt>Effects</dt><dd>{{draft.effectCount}}</dd></div>
        </dl>
        {{#if draft.activities.length}}
        <div class="ic-spell-activity-list">
          <strong>Activities</strong>
          {{#each draft.activities}}<span><i class="fa-solid fa-bolt"></i> {{name}} <small>{{typeLabel}}</small></span>{{/each}}
        </div>
        {{/if}}
        <aside class="ic-spell-native-note"><i class="fa-solid fa-shield-halved"></i><p>Spell Factory does not replace D&D5e mechanics. A Summon Activity remains a native Summon Activity; Damage, Save, Attack, Heal, Effects, Concentration, and scaling are authored by the system's own editor.</p></aside>
      </section>

      <section class="ic-spell-class-panel">
        <header><span class="ic-kicker">Spell Availability</span><h3>Class Spell Lists</h3><p>Every published Spell must belong to at least one class list. These assignments are stored on the canonical Spell for Character Builder / spell-list integration.</p></header>
        <div class="ic-spell-class-grid">
          {{#each classOptions}}
          <label><input type="checkbox" data-spell-class value="{{id}}" {{#if selected}}checked{{/if}}> <span>{{label}}</span></label>
          {{/each}}
        </div>
        <small>{{classCount}} class list(s) selected</small>
      </section>
    </div>

    <section class="ic-spell-publish-bar">
      <div><i class="fa-solid fa-circle-info"></i><span>{{status}}</span></div>
      <div>
        <button type="button" class="danger" data-action="discard-spell-draft" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-trash"></i> Discard Draft</button>
        <button type="button" class="ic-primary-continue" data-action="publish-spell" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-check"></i> {{#if editingPublished}}Update Published{{else}}Publish Spell{{/if}}</button>
      </div>
    </section>
  </main>
  {{/unless}}

  <footer class="ic-spell-factory-footer"><i class="fa-solid {{#if busy}}fa-spinner fa-spin{{else}}fa-circle-check{{/if}}"></i><span>{{status}}</span></footer>
</div>
