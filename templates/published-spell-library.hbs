<div class="ic-published-shell">
  <header class="ic-published-header">
    <div>
      <span class="ic-kicker">Canonical Homebrew Spell Library</span>
      <h1>Published Spells</h1>
      <p>{{packLabel}} · v{{version}} · {{spellCount}} visible spell(s)</p>
    </div>
    <div class="ic-spell-library-header-actions">
      <button type="button" data-action="new-spell"><i class="fa-solid fa-wand-magic-sparkles"></i> New Spell</button>
      <button type="button" data-action="open-native-spell-pack"><i class="fa-solid fa-book-atlas"></i> Open Compendium</button>
    </div>
  </header>

  <section class="ic-published-toolbar">
    <label class="ic-published-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" value="{{search}}" data-spell-search placeholder="Search published spells"></label>
    <select data-spell-school>
      {{#each schools}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    <label class="ic-published-archived"><input type="checkbox" data-spell-archived {{#if includeArchived}}checked{{/if}}> Show Archived</label>
  </section>

  <div class="ic-published-list">
    {{#if empty}}
      <section class="ic-published-empty"><i class="fa-solid fa-wand-sparkles"></i><h2>No published spells match this view.</h2><p>Use <strong>New Spell</strong> to start blank or clone an existing Spell as a blueprint.</p></section>
    {{/if}}

    {{#each groups}}
      <section class="ic-published-group" data-folder-node="{{key}}">
        <header><i class="fa-solid {{icon}}"></i><h2>{{label}}</h2><span>{{count}}</span></header>
        <div class="ic-published-cards">
          {{#each items}}
          <article class="ic-published-card {{#if archived}}archived{{/if}}" data-published-spell data-spell-id="{{id}}" data-uuid="{{uuid}}" data-search="{{searchText}}">
            <img src="{{img}}" alt="">
            <div class="ic-published-card-main">
              <strong>{{name}}</strong>
              <small>{{levelLabel}} · {{schoolLabel}}{{#if classLabel}} · {{classLabel}}{{/if}}</small>
              <small>Revision {{revision}} · {{#if archived}}Archived{{else}}Published{{/if}}</small>
            </div>
            <div class="ic-published-card-actions">
              <button type="button" data-action="edit-published-spell" data-spell-id="{{id}}" title="Edit through Spell Factory"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
              <button type="button" data-action="archive-published-spell" data-spell-id="{{id}}" title="{{#if archived}}Restore{{else}}Archive{{/if}}"><i class="fa-solid {{#if archived}}fa-box-open{{else}}fa-box-archive{{/if}}"></i></button>
              <button type="button" class="danger" data-action="delete-published-spell" data-spell-id="{{id}}" title="Delete permanently"><i class="fa-solid fa-trash"></i></button>
            </div>
          </article>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </div>
</div>
