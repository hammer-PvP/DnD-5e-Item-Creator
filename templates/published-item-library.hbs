<div class="ic-published-shell">
  <header class="ic-published-header">
    <div>
      <span class="ic-kicker">Canonical Homebrew Library</span>
      <h1>Published Items</h1>
      <p>{{packLabel}} · v{{version}} · {{itemCount}} visible item(s)</p>
    </div>
    <button type="button" data-action="open-native-pack"><i class="fa-solid fa-box-archive"></i> Open Compendium</button>
  </header>

  <section class="ic-published-toolbar">
    <label class="ic-published-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" value="{{search}}" data-published-search placeholder="Search all published folders and items"></label>
    <select data-published-type>
      {{#each categories}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    <label class="ic-published-archived"><input type="checkbox" data-published-archived {{#if includeArchived}}checked{{/if}}> Show Archived</label>
  </section>

  <div class="ic-published-list">
    {{#if empty}}
      <section class="ic-published-empty"><i class="fa-solid fa-box-open"></i><h2>No published items match this view.</h2><p>Create or edit an Item with Item Creator and use <strong>Publish New</strong>.</p></section>
    {{/if}}

    {{#each groups}}
      <section class="ic-published-group" data-folder-node="{{key}}">
        <header><i class="fa-solid {{icon}}"></i><h2>{{label}}</h2><span>{{count}}</span></header>

        {{#if items.length}}
        <div class="ic-published-cards ic-published-root-items">
          {{#each items}}
          <article class="ic-published-card {{#if archived}}archived{{/if}}" data-published-item data-item-id="{{id}}" data-uuid="{{uuid}}" data-search="{{searchText}}">
            <img src="{{img}}" alt="">
            <div class="ic-published-card-main">
              <strong>{{name}}</strong>
              <small>{{type}}{{#if subtype}} · {{subtype}}{{/if}}{{#if rarity}} · {{rarity}}{{/if}}</small>
              <small>Revision {{revision}} · {{#if archived}}Archived{{else}}Published{{/if}}</small>
            </div>
            <div class="ic-published-card-actions">
              <button type="button" data-action="edit-published" data-item-id="{{id}}" title="Edit in Item Creator"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
              <button type="button" data-action="world-copy" data-item-id="{{id}}" title="Create a World Item copy"><i class="fa-solid fa-vial"></i></button>
              <button type="button" data-action="archive-published" data-item-id="{{id}}" title="{{#if archived}}Restore{{else}}Archive{{/if}}"><i class="fa-solid {{#if archived}}fa-box-open{{else}}fa-box-archive{{/if}}"></i></button>
              <button type="button" class="danger" data-action="delete-published" data-item-id="{{id}}" title="Delete permanently"><i class="fa-solid fa-trash"></i></button>
            </div>
          </article>
          {{/each}}
        </div>
        {{/if}}

        {{#each children}}
          {{#if count}}
          <section class="ic-published-subgroup" data-folder-node="{{key}}">
            <header><i class="fa-regular fa-folder-open"></i><h3>{{label}}</h3><span>{{count}}</span></header>
            <div class="ic-published-cards">
              {{#each items}}
              <article class="ic-published-card {{#if archived}}archived{{/if}}" data-published-item data-item-id="{{id}}" data-uuid="{{uuid}}" data-search="{{searchText}}">
                <img src="{{img}}" alt="">
                <div class="ic-published-card-main">
                  <strong>{{name}}</strong>
                  <small>{{type}}{{#if subtype}} · {{subtype}}{{/if}}{{#if rarity}} · {{rarity}}{{/if}}</small>
                  <small>Revision {{revision}} · {{#if archived}}Archived{{else}}Published{{/if}}</small>
                </div>
                <div class="ic-published-card-actions">
                  <button type="button" data-action="edit-published" data-item-id="{{id}}" title="Edit in Item Creator"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
                  <button type="button" data-action="world-copy" data-item-id="{{id}}" title="Create a World Item copy"><i class="fa-solid fa-vial"></i></button>
                  <button type="button" data-action="archive-published" data-item-id="{{id}}" title="{{#if archived}}Restore{{else}}Archive{{/if}}"><i class="fa-solid {{#if archived}}fa-box-open{{else}}fa-box-archive{{/if}}"></i></button>
                  <button type="button" class="danger" data-action="delete-published" data-item-id="{{id}}" title="Delete permanently"><i class="fa-solid fa-trash"></i></button>
                </div>
              </article>
              {{/each}}
            </div>
          </section>
          {{/if}}
        {{/each}}
      </section>
    {{/each}}
  </div>
</div>
