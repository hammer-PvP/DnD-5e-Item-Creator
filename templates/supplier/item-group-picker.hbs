<div class="supplier-picker-shell supplier-group-picker-shell">
  <header class="supplier-picker-header supplier-group-picker-header">
    <div class="supplier-grid two">
      <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.ProfileV2.GroupName"}}</span><input type="text" name="groupName" value="{{group.name}}"></label>
      <div class="supplier-group-mode"><span>{{localize "DND5E_SUPPLIER.ProfileV2.SelectionMode"}}</span><label><input type="radio" name="selectionMode" value="dynamic" {{#if dynamicMode}}checked{{/if}}> {{localize "DND5E_SUPPLIER.ProfileV2.DynamicFilter"}}</label><label><input type="radio" name="selectionMode" value="explicit" {{#if explicitMode}}checked{{/if}}> {{localize "DND5E_SUPPLIER.ProfileV2.ExplicitSelection"}}</label></div>
    </div>

    <div class="supplier-grid three supplier-group-primary-filters">
      <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Picker.Source"}}</span><select data-filter="source">{{#each sourceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.ProfileV2.MagicalState"}}</span><select data-filter="magical"><option value="any" {{#if magicalAny}}selected{{/if}}>{{localize "DND5E_SUPPLIER.ProfileV2.Any"}}</option><option value="mundane" {{#if magicalMundane}}selected{{/if}}>{{localize "DND5E_SUPPLIER.ProfileV2.Mundane"}}</option><option value="magical" {{#if magicalMagical}}selected{{/if}}>{{localize "DND5E_SUPPLIER.ProfileV2.Magical"}}</option></select></label>
      <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.ProfileV2.IdentityTerms"}}</span><input type="text" data-filter="identity" value="{{identityTermsText}}" placeholder="horse, wagon, potion of healing"></label>
      <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.ProfileV2.IdentityExclusions"}}</span><input type="text" data-filter="identity-exclusions" value="{{identityExclusionsText}}" placeholder="animal, firearm, arcane focus"></label>
      <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.ProfileV2.AffinityWeight"}}</span><input type="number" min="0.01" step="0.25" data-filter="selection-weight" value="{{group.selectionWeight}}"></label>
    </div>

    <details class="supplier-group-filter-panel" open>
      <summary><i class="fa-solid fa-filter"></i>{{localize "DND5E_SUPPLIER.ProfileV2.CoreItemFilters"}}</summary>
      <div class="supplier-group-filter-columns">
        <div><strong>{{localize "DND5E_SUPPLIER.Picker.Type"}}</strong><div class="supplier-filter-chip-grid">{{#each typeOptions}}<label><input type="checkbox" data-group-array="itemTypes" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></div>
        <div><strong>{{localize "DND5E_SUPPLIER.Picker.Subtype"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each subtypeOptions}}<label><input type="checkbox" data-group-array="subtypes" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></div>
        <div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.Rarity"}}</strong><div class="supplier-filter-chip-grid">{{#each rarityOptions}}<label><input type="checkbox" data-group-array="rarities" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.DocumentNature"}}</strong><div class="supplier-filter-chip-grid">{{#each natureOptions}}<label><input type="checkbox" data-group-array="documentNatures" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></div>
      </div>
    </details>

    <details class="supplier-group-filter-panel supplier-crafting-filter-panel">
      <summary><i class="fa-solid fa-mortar-pestle"></i>{{localize "DND5E_SUPPLIER.ProfileV2.CraftingMetadata"}}</summary>
      <p>{{localize "DND5E_SUPPLIER.ProfileV2.CraftingMetadataHint"}}</p>
      <div class="supplier-crafting-mode-row"><label><input type="checkbox" data-crafting-toggle="materialOnly" {{#if materialOnly}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialOnly"}}</span></label><label><input type="checkbox" data-crafting-toggle="productOnly" {{#if productOnly}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.ProfileV2.ProductOnly"}}</span></label><label><input type="checkbox" data-crafting-toggle="knowledgeOnly" {{#if knowledgeOnly}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.ProfileV2.KnowledgeOnly"}}</span></label></div>
      <div class="supplier-crafting-exclusion-row">
        <span>{{localize "DND5E_SUPPLIER.ProfileV2.CraftingExclusions"}}</span>
        <label><input type="checkbox" data-crafting-toggle="excludeMaterials" {{#if excludeMaterials}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.ProfileV2.ExcludeMaterials"}}</span></label>
        <label><input type="checkbox" data-crafting-toggle="excludeProducts" {{#if excludeProducts}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.ProfileV2.ExcludeProducts"}}</span></label>
        <label><input type="checkbox" data-crafting-toggle="excludeKnowledge" {{#if excludeKnowledge}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.ProfileV2.ExcludeKnowledge"}}</span></label>
      </div>
      <small class="supplier-crafting-knowledge-note"><i class="fa-solid fa-book-open"></i>{{localize "DND5E_SUPPLIER.ProfileV2.KnowledgeDefaultHint"}}</small>
      <div class="supplier-group-filter-columns crafting">
        <div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialFamily"}}</strong><div class="supplier-filter-chip-grid">{{#each materialFamilyOptions}}<label><input type="checkbox" data-group-array="materialFamilies" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialNature"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each materialNatureOptions}}<label><input type="checkbox" data-group-array="materialNatures" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialCategory"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each materialCategoryOptions}}<label><input type="checkbox" data-group-array="materialCategories" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></div>
        <div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialTags"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each materialTagOptions}}<label><input type="checkbox" data-group-array="materialTags" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialRequires"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each materialRequireOptions}}<label><input type="checkbox" data-group-array="materialRequires" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.MaterialBiomes"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each materialBiomeOptions}}<label><input type="checkbox" data-group-array="materialBiomes" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></div>
        <div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.ProductCategory"}}</strong><div class="supplier-filter-chip-grid">{{#each productCategoryOptions}}<label><input type="checkbox" data-group-array="productCategories" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.ProductSubcategory"}}</strong><div class="supplier-filter-chip-grid">{{#each productSubcategoryOptions}}<label><input type="checkbox" data-group-array="productSubcategories" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.ProductCulture"}}</strong><div class="supplier-filter-chip-grid scrollable">{{#each productCultureOptions}}<label><input type="checkbox" data-group-array="productCultures" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div><strong>{{localize "DND5E_SUPPLIER.ProfileV2.ProductMealType"}}</strong><div class="supplier-filter-chip-grid">{{#each productMealTypeOptions}}<label><input type="checkbox" data-group-array="productMealTypes" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></div>
      </div>
    </details>

    <label class="supplier-picker-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-action="search" placeholder="{{localize 'DND5E_SUPPLIER.Picker.Search'}}"></label>
    <div class="supplier-group-picker-actions"><span><b data-visible-count>0</b> {{localize "DND5E_SUPPLIER.Picker.Results"}}</span><button type="button" class="supplier-secondary" data-action="select-visible"><i class="fa-solid fa-check-double"></i>{{localize "DND5E_SUPPLIER.ProfileV2.SelectAllVisible"}}</button><button type="button" class="supplier-secondary" data-action="clear-visible"><i class="fa-solid fa-xmark"></i>{{localize "DND5E_SUPPLIER.ProfileV2.ClearVisible"}}</button></div>
    <small>{{#if dynamicMode}}{{localize "DND5E_SUPPLIER.ProfileV2.DynamicFilterHint"}}{{else}}{{localize "DND5E_SUPPLIER.ProfileV2.ExplicitSelectionHint"}}{{/if}}</small>
  </header>

  <div class="supplier-picker-list">
    {{#each entries}}
      <article class="supplier-picker-row supplier-picker-split-row {{#if checked}}selected{{/if}}" data-picker-row data-group-hidden="{{hiddenByGroup}}" data-search="{{searchText}}" data-uuid="{{uuid}}">
        <label class="supplier-picker-item-checkbox"><input type="checkbox" data-action="toggle-item" {{#if checked}}checked{{/if}}><span></span></label>
        <button type="button" class="supplier-picker-item-body" data-action="open-document" data-uuid="{{uuid}}"><img src="{{img}}" alt=""><span class="supplier-picker-main"><strong>{{name}}</strong><small>{{type}}{{#if subtypeLabel}} / {{subtypeLabel}}{{/if}} • {{rarity}}{{#if firearmNormalized}} • <em>{{localize "DND5E_SUPPLIER.ProfileV2.FirearmWillNormalize"}}</em>{{/if}}</small></span><span class="supplier-picker-source">{{sourceDisplay}}</span><i class="fa-solid fa-up-right-from-square supplier-picker-check"></i></button>
      </article>
    {{/each}}
  </div>
  <footer class="supplier-picker-footer"><span>{{localize "DND5E_SUPPLIER.ProfileV2.GroupBuilderFooter"}}</span><button type="button" class="supplier-primary" data-action="save-group"><i class="fa-solid fa-check"></i>{{localize "DND5E_SUPPLIER.ProfileV2.SaveGroup"}}</button></footer>
</div>
